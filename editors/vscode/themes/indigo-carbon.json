  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#A1A8BA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#A5D9A1",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C5ACF5",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#EAC382",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8EC7FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#88D5CF",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#E1E4ED",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#F0BFA5",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F2919D",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#EAC382",
        "fontStyle": ""
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#9BA9FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#E1E4ED",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E1E4ED",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#F2919D",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Tua: Types",
      "scope": [
        "entity.name.type.tua",
        "support.type.primitive.tua",
        "support.type.builtin.tua",
        "entity.other.inherited-class.tua"
      ],
      "settings": {
        "foreground": "#88D5CF",
        "fontStyle": ""
      }
    },
    {
      "name": "Tua: Functions",
      "scope": [
        "entity.name.function.tua",
        "support.function.tua"
      ],
      "settings": {
        "foreground": "#8EC7FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Tua: Parameters",
      "scope": [
        "variable.parameter.tua"
      ],
      "settings": {
        "foreground": "#F0BFA5",
        "fontStyle": ""
      }
    },
    {
      "name": "Tua: Variables and properties",
      "scope": [
        "variable.other.tua"
      ],
      "settings": {
        "foreground": "#E1E4ED",
        "fontStyle": ""
      }
    },
    {
      "name": "Tua: Modules",
      "scope": [
        "support.variable.namespace.tua",
        "entity.name.namespace.module.tua"
      ],
      "settings": {
        "foreground": "#B8C9DC",
        "fontStyle": ""
      }
    },
    {
      "name": "Tua: Events and enum members",
      "scope": [
        "entity.name.event.tua",
        "variable.other.enummember.tua"
      ],
      "settings": {
        "foreground": "#EAC382",
        "fontStyle": ""
      }
    },
    {
      "name": "Tua: Annotations",
      "scope": [
        "storage.type.annotation.tua"
      ],
      "settings": {
        "foreground": "#C5ACF5",
        "fontStyle": ""
      }
    },
    {
      "name": "Tua: Labels",
      "scope": [
        "entity.name.label.tua"
      ],
      "settings": {
        "foreground": "#B8C9DC",
        "fontStyle": ""
      }
    },
    {
      "name": "Tua: Operators",
      "scope": [
        "keyword.operator.tua"
      ],
      "settings": {
        "foreground": "#B8C0D0",
        "fontStyle": ""
      }
    },
    {
      "name": "Tua: Control words",
      "scope": [
        "keyword.operator.word.tua"
      ],
      "settings": {
        "foreground": "#C5ACF5",
        "fontStyle": ""
      }
    },
    {
      "name": "Tua: Punctuation",
      "scope": [
        "punctuation.accessor.tua",
        "punctuation.separator.tua",
        "punctuation.section.tua",
        "punctuation.definition.parameters.tua",
        "punctuation.definition.type-annotation.tua",
        "punctuation.definition.type-table.tua",
        "punctuation.definition.type-group.tua",
        "punctuation.definition.type-index.tua"
      ],
      "settings": {
        "foreground": "#A1A8BA",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
