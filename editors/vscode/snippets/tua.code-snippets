{
  "Local Function": {
    "prefix": "lfn",
    "body": [
      "local function ${1:name}(${2})${3:: ${4:any}}",
      "  ${0}",
      "end"
    ],
    "description": "Create a typed local function."
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}(${2})${3:: ${4:any}}",
      "  ${0}",
      "end"
    ],
    "description": "Create a typed function."
  },
  "Method": {
    "prefix": "method",
    "body": [
      "function ${1:Table}:${2:name}(${3})${4:: ${5:any}}",
      "  ${0}",
      "end"
    ],
    "description": "Create a colon-call method."
  },
  "Type Alias": {
    "prefix": "type",
    "body": [
      "type ${1:Name} = {",
      "  ${2:field}: ${3:any}",
      "}"
    ],
    "description": "Create a Tua table type alias."
  },
  "Open Class": {
    "prefix": "openclass",
    "body": [
      "open class ${1:Name}${2: extends ${3:Base}} {",
      "  ${4:field}: ${5:any}",
      "",
      "  init(${6}) {",
      "    ${0}",
      "  }",
      "}"
    ],
    "description": "Create an inheritable Tua class."
  },
  "Final Class": {
    "prefix": "finalclass",
    "body": [
      "final class ${1:Name}${2: extends ${3:Base}} {",
      "  ${4:field}: ${5:any}",
      "",
      "  final update(${6:dt}: number) {",
      "    ${0}",
      "  }",
      "}"
    ],
    "description": "Create a final Tua class with a final method."
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} then",
      "  ${0}",
      "end"
    ],
    "description": "Create an if statement."
  },
  "For Range": {
    "prefix": "fori",
    "body": [
      "for ${1:i} = ${2:1}, ${3:count} do",
      "  ${0}",
      "end"
    ],
    "description": "Create a numeric for loop."
  },
  "For Pairs": {
    "prefix": "forp",
    "body": [
      "for ${1:key}, ${2:value} in pairs(${3:table}) do",
      "  ${0}",
      "end"
    ],
    "description": "Create a pairs loop."
  },
  "LOVE Load": {
    "prefix": "loveload",
    "body": [
      "function love.load()",
      "  ${0}",
      "end"
    ],
    "description": "Create love.load callback."
  },
  "LOVE Update": {
    "prefix": "loveupdate",
    "body": [
      "function love.update(dt: number)",
      "  ${0}",
      "end"
    ],
    "description": "Create love.update callback."
  },
  "LOVE Draw": {
    "prefix": "lovedraw",
    "body": [
      "function love.draw()",
      "  ${0}",
      "end"
    ],
    "description": "Create love.draw callback."
  },
  "LOVE Keypressed": {
    "prefix": "lovekey",
    "body": [
      "function love.keypressed(key: string)",
      "  ${0}",
      "end"
    ],
    "description": "Create love.keypressed callback."
  }
}
