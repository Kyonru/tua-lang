{
  "name": "tua",
  "displayName": "tua",
  "description": "Language support for tua, a typed Lua superset for LuaJIT and LOVE projects.",
  "version": "0.1.0",
  "publisher": "tua-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kyonru/tua-lang.git"
  },
  "homepage": "https://kyonru.github.io/tua-lang",
  "bugs": {
    "url": "https://github.com/Kyonru/tua-lang/issues"
  },
  "icon": "assets/logo.png",
  "main": "./src/extension.js",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onCommand:tua.initProject",
    "onCommand:tua.debugLoveProject",
    "onLanguage:tua",
    "workspaceContains:**/*.tua"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "check": "node ../../scripts/sync-version.js --check && node ../../scripts/generate-config-schema.js --check && node scripts/check-js.js && node scripts/syntax-grammar-check.js && node scripts/manifest-check.js && node scripts/activation-smoke.js",
    "test:vscode": "node test/run.js"
  },
  "contributes": {
    "breakpoints": [
      {
        "language": "tua"
      }
    ],
    "configurationDefaults": {
      "[tua]": {
        "editor.quickSuggestions": {
          "comments": "off",
          "strings": "on",
          "other": "on"
        },
        "editor.quickSuggestionsDelay": 0,
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "tua",
      "properties": {
        "tua.server.path": {
          "type": "string",
          "default": "tua",
          "description": "Path to the tua executable used to launch the language server."
        },
        "tua.love.command": {
          "type": "string",
          "default": "love",
          "description": "Path to the LOVE executable used by Tua: Run LOVE Project and Tua: Debug LOVE Project. The default uses love on PATH and falls back to common platform installs when available."
        },
        "tua.trace.server": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "description": "Controls Tua language-server trace messages. Changes apply without restarting when supported by the server."
        },
        "tua.log.verbosity": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "error",
            "info",
            "debug",
            "trace"
          ],
          "description": "Controls Tua language-server log verbosity. Changes apply without restarting when supported by the server."
        },
        "tua.format.indentWidth": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "description": "Spaces per indentation level for the Tua formatter. Null inherits [format].indent_width from tua.toml."
        },
        "tua.format.lineWidth": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "description": "Preferred line width for the Tua formatter. Null inherits [format].line_width from tua.toml."
        },
        "tua.format.quoteStyle": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "enum": [
            "preserve",
            null
          ],
          "description": "Quote style for the Tua formatter. Preserve keeps the source quote style; null inherits tua.toml."
        },
        "tua.format.finalNewline": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Whether the formatter writes a final newline. Null inherits [format].final_newline from tua.toml."
        },
        "tua.diagnostics.duplicateKeys": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report duplicate table keys."
        },
        "tua.diagnostics.missingRequires": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report require calls that cannot be resolved."
        },
        "tua.diagnostics.selfAssignments": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report assignments where the target and value are the same symbol."
        },
        "tua.diagnostics.docAnnotations": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report malformed LuaHelper/LuaLS-style documentation annotations."
        },
        "tua.diagnostics.undefinedVariables": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report undefined variables when static analysis can prove them."
        },
        "tua.diagnostics.unusedLocals": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report unused local variables."
        },
        "tua.diagnostics.unusedParameters": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report unused function parameters."
        },
        "tua.diagnostics.useBeforeDefinition": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report provable use of locals before their definition."
        },
        "tua.diagnostics.duplicateParameters": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report duplicate function parameter names."
        },
        "tua.diagnostics.wrongArgumentCount": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report calls with the wrong number of arguments."
        },
        "tua.diagnostics.badRequires": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report invalid require targets."
        },
        "tua.diagnostics.impossibleBooleanExpressions": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report boolean expressions that can never be true."
        },
        "tua.diagnostics.duplicateIfConditions": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report repeated if or elseif conditions."
        },
        "tua.diagnostics.duplicateBinaryOperands": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report suspicious repeated binary operands."
        },
        "tua.diagnostics.floatEquality": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report direct equality comparisons on numbers."
        },
        "tua.diagnostics.constAssignments": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report assignments to values marked as constant."
        },
        "tua.diagnostics.parameterTypeMismatches": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report function argument type mismatches."
        },
        "tua.diagnostics.returnTypeMismatches": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report function return type mismatches."
        },
        "tua.diagnostics.assignmentArity": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report proven assignment value-count mismatches."
        },
        "tua.diagnostics.localDeclarationArity": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report proven local initializer-count mismatches."
        },
        "tua.diagnostics.unusedAssignments": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report assignments to locals that are never read afterwards."
        },
        "tua.diagnostics.binaryOperatorTypeMismatches": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report binary operators with statically incompatible operand types."
        },
        "tua.diagnostics.uncalledLocalFunctions": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report local functions that are referenced but never called."
        },
        "tua.diagnostics.formattingLints": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report opinionated Lua/Tua formatting consistency issues such as trailing whitespace, indentation, line width, keyword spacing, and token spacing. Null inherits [diagnostics].formatting_lints from tua.toml."
        },
        "tua.diagnostics.inlineIgnores": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Enable inline diagnostic suppression comments."
        },
        "tua.diagnostics.inlineIgnoreScopes": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          },
          "description": "Allowed inline diagnostic suppression directives."
        },
        "tua.diagnostics.inlineIgnoreMaxPerFile": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "description": "Maximum inline diagnostic suppression comments per file; zero is unlimited."
        },
        "tua.diagnostics.globals": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          },
          "description": "Additional global names accepted by diagnostics."
        },
        "tua.jit.enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Enable opt-in LuaJIT shape guidance diagnostics (TL4032-TL4034). Null inherits [jit].enabled from tua.toml."
        },
        "tua.ecs.enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Enable Tua's built-in ECS module, typed APIs, and ECS diagnostics. Null inherits [ecs].enabled from tua.toml."
        },
        "tua.completion.sequenceRanking.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the experimental local contextual sequence ranking lane for completion ordering. Compiler candidates remain the only returned candidates."
        },
        "tua.completion.sequenceRanking.timeoutMs": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 25,
          "description": "Maximum time budget in milliseconds for contextual sequence ranking. Timeout returns the pre-sequence completion ordering."
        },
        "tua.completion.sequenceRanking.maxCandidates": {
          "type": "number",
          "default": 64,
          "minimum": 0,
          "maximum": 500,
          "description": "Maximum number of compiler candidates sent to the contextual sequence ranking lane."
        },
        "tua.completion.multiToken.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the experimental multi-token completion lane. Compiler token completions remain the primary path."
        },
        "tua.completion.multiToken.advanced": {
          "type": "boolean",
          "default": false,
          "description": "Allow multi-token suggestions even when primary compiler completion has normal confidence. When false, suggestions only appear in low-confidence local contexts."
        },
        "tua.completion.multiToken.allowModelIntegration": {
          "type": "boolean",
          "default": false,
          "description": "Explicit policy gate for any future model-backed multi-token completion provider. The current implementation remains local-only."
        },
        "tua.completion.multiToken.maxSuggestions": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "Maximum number of validated multi-token suggestions appended to completion results."
        },
        "tua.fileAssociations": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "lua",
              "tua"
            ]
          },
          "description": "Map glob patterns to language kinds so extra file extensions can be indexed as Lua or tua sources."
        },
        "tua.ignoredPaths": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Path patterns excluded from indexing and diagnostics."
        },
        "tua.requirePathSeparator": {
          "type": "string",
          "default": ".",
          "enum": [
            ".",
            "/"
          ],
          "description": "Separator used when tua suggests require paths."
        },
        "tua.preview.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable experimental preview features in editor integrations."
        }
      }
    },
    "commands": [
      {
        "command": "tua.initProject",
        "title": "Initialize Tua Project",
        "category": "Tua",
        "icon": "$(new-folder)"
      },
      {
        "command": "tua.restartServer",
        "title": "Restart Language Server",
        "category": "Tua"
      },
      {
        "command": "tua.output.focus",
        "title": "Focus Output",
        "category": "Tua"
      },
      {
        "command": "tua.openSettings",
        "title": "Open Settings",
        "category": "Tua"
      },
      {
        "command": "tua.selectServer",
        "title": "Select Server",
        "category": "Tua"
      },
      {
        "command": "tua.copyDebugInfo",
        "title": "Copy Debug Info",
        "category": "Tua"
      },
      {
        "command": "tua.copyCacheStats",
        "title": "Copy Cache Stats",
        "category": "Tua"
      },
      {
        "command": "tua.saveCacheStats",
        "title": "Save Cache Stats",
        "category": "Tua"
      },
      {
        "command": "tua.showServerHealth",
        "title": "Show Language Server Health",
        "category": "Tua",
        "icon": "$(pulse)"
      },
      {
        "command": "tua.resetCompletionStats",
        "title": "Reset Completion Learning Stats",
        "category": "Tua"
      },
      {
        "command": "tua.completion.toggleExperimental",
        "title": "Toggle Experimental Completions",
        "category": "Tua"
      },
      {
        "command": "tua.saveCpuProfile",
        "title": "Save CPU Profile",
        "category": "Tua"
      },
      {
        "command": "tua.saveHeapSummary",
        "title": "Save Heap Summary",
        "category": "Tua"
      },
      {
        "command": "tua.openGeneratedLua",
        "title": "Open Generated Lua Beside Tua",
        "category": "Tua",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tua.jumpBetweenSourceAndGenerated",
        "title": "Jump Between Tua and Generated Lua",
        "category": "Tua",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "tua.runLoveProject",
        "title": "Run LOVE Project",
        "category": "Tua",
        "icon": "$(play)"
      },
      {
        "command": "tua.debugLoveProject",
        "title": "Debug LOVE Project",
        "category": "Tua",
        "icon": "$(debug-alt)"
      },
      {
        "command": "tua.restartLoveProject",
        "title": "Restart LOVE Project",
        "category": "Tua",
        "icon": "$(debug-restart)"
      },
      {
        "command": "tua.copyQualifiedName",
        "title": "Copy Fully Qualified Symbol Name",
        "category": "Tua",
        "icon": "$(copy)"
      },
      {
        "command": "tua.showWorkspaceSymbolsByModule",
        "title": "Workspace Symbols by Module",
        "category": "Tua",
        "icon": "$(list-tree)"
      },
      {
        "command": "tua.hover.references",
        "title": "Show References from Hover",
        "category": "Tua"
      },
      {
        "command": "tua.hover.implementations",
        "title": "Show Implementations from Hover",
        "category": "Tua"
      },
      {
        "command": "tua.inlayHints.selectMode",
        "title": "Select Inlay Hint Mode",
        "category": "Tua",
        "icon": "$(ellipsis)"
      },
      {
        "command": "tua.explainType",
        "title": "Explain Type / Why Is This Any?",
