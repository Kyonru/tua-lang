      },
      {
        "command": "tua.assets.open",
        "title": "Open Asset",
        "category": "Tua"
      },
      {
        "command": "tua.assets.openReference",
        "title": "Open Asset Reference",
        "category": "Tua"
      },
      {
        "command": "tua.assets.findReferences",
        "title": "Find Asset References",
        "category": "Tua",
        "icon": "$(references)"
      },
      {
        "command": "tua.assets.rename",
        "title": "Rename Asset...",
        "category": "Tua",
        "icon": "$(edit)"
      },
      {
        "command": "tua.assets.reveal",
        "title": "Reveal Asset in File Explorer",
        "category": "Tua",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tua.showSignalGraph",
        "title": "Show Signal Graph",
        "category": "Tua",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "tua.showModuleGraph",
        "title": "Show Module Dependency Graph",
        "category": "Tua",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "tua.showEcsExplorer",
        "title": "Show ECS Explorer",
        "category": "Tua",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "tua.showObjectPoolExplorer",
        "title": "Show Object Pool Explorer",
        "category": "Tua",
        "icon": "$(database)"
      },
      {
        "command": "tua.whyModuleIncluded",
        "title": "Why Is This Module Included?",
        "category": "Tua",
        "icon": "$(question)"
      },
      {
        "command": "tua.source.organizeImports",
        "title": "Organize Imports",
        "category": "Tua"
      },
      {
        "command": "tua.source.sortImports",
        "title": "Sort Imports",
        "category": "Tua"
      },
      {
        "command": "tua.source.removeUnusedImports",
        "title": "Remove Unused Imports",
        "category": "Tua"
      },
      {
        "command": "tua.source.fixAll",
        "title": "Fix All Safe Diagnostics",
        "category": "Tua"
      },
      {
        "command": "tua.reportIssue",
        "title": "Report Issue",
        "category": "Tua"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "tua.assets",
          "name": "Tua Assets",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "tua.inlayHints.selectMode",
          "when": "editorLangId == tua",
          "group": "navigation@40"
        },
        {
          "command": "tua.openGeneratedLua",
          "when": "editorLangId == tua",
          "group": "navigation@45"
        },
        {
          "command": "tua.jumpBetweenSourceAndGenerated",
          "when": "editorLangId == tua || resourceExtname == .lua",
          "group": "navigation@46"
        },
        {
          "command": "tua.runLoveProject",
          "when": "workspaceFolderCount > 0",
          "group": "navigation@48"
        },
        {
          "command": "tua.debugLoveProject",
          "when": "workspaceFolderCount > 0",
          "group": "navigation@49"
        },
        {
          "command": "tua.restartLoveProject",
          "when": "workspaceFolderCount > 0",
          "group": "navigation@50"
        },
        {
          "command": "tua.showWorkspaceSymbolsByModule",
          "when": "editorLangId == tua",
          "group": "navigation@47"
        },
        {
          "command": "tua.showSignalGraph",
          "when": "editorLangId == tua",
          "group": "navigation@50"
        }
      ],
      "commandPalette": [
        {
          "command": "tua.initProject"
        },
        {
          "command": "tua.explainType",
          "when": "editorLangId == tua"
        },
        {
          "command": "tua.inlayHints.selectMode",
          "when": "editorLangId == tua"
        },
        {
          "command": "tua.openGeneratedLua",
          "when": "editorLangId == tua"
        },
        {
          "command": "tua.jumpBetweenSourceAndGenerated",
          "when": "editorLangId == tua || resourceExtname == .lua"
        },
        {
          "command": "tua.runLoveProject",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "tua.debugLoveProject",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "tua.restartLoveProject",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "tua.copyQualifiedName",
          "when": "editorLangId == tua"
        },
        {
          "command": "tua.showWorkspaceSymbolsByModule",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "tua.showServerHealth",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "tua.hover.references",
          "when": "false"
        },
        {
          "command": "tua.hover.implementations",
          "when": "false"
        },
        {
          "command": "tua.whyModuleIncluded",
          "when": "editorLangId == tua"
        },
        {
          "command": "tua.showObjectPoolExplorer",
          "when": "editorLangId == tua"
        },
        {
          "command": "tua.assets.preview",
          "when": "false"
        },
        {
          "command": "tua.assets.open",
          "when": "false"
        },
        {
          "command": "tua.assets.openReference",
          "when": "false"
        },
        {
          "command": "tua.assets.findReferences",
          "when": "false"
        },
        {
          "command": "tua.assets.rename",
          "when": "false"
        },
        {
          "command": "tua.assets.reveal",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "tua.explainType",
          "when": "editorLangId == tua",
          "group": "navigation@40"
        },
        {
          "command": "tua.whyModuleIncluded",
          "when": "editorLangId == tua",
          "group": "navigation@50"
        },
        {
          "command": "tua.copyQualifiedName",
          "when": "editorLangId == tua",
          "group": "navigation@60"
        }
      ],
      "view/title": [
        {
          "command": "tua.assets.refresh",
          "when": "view == tua.assets",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tua.assets.findReferences",
          "when": "view == tua.assets && viewItem == tuaAsset.used",
          "group": "navigation@10"
        },
        {
          "command": "tua.assets.rename",
          "when": "view == tua.assets && (viewItem == tuaAsset.used || viewItem == tuaAsset.unused)",
          "group": "navigation@20"
        },
        {
          "command": "tua.assets.reveal",
          "when": "view == tua.assets && (viewItem == tuaAsset.used || viewItem == tuaAsset.unused)",
          "group": "navigation@30"
        }
      ]
    },
    "languages": [
      {
        "id": "tua",
        "aliases": [
          "tua",
          "Tua"
        ],
        "extensions": [
          ".tua"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/logo.svg",
          "dark": "./assets/logo.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "tua",
        "scopeName": "source.tua",
        "path": "./syntaxes/tua.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "tua",
        "scopes": {
          "type": [
            "entity.name.type.tua"
          ],
          "type.defaultLibrary": [
            "support.type.builtin.tua",
            "support.type.primitive.tua"
          ],
          "class": [
            "entity.name.type.class.tua"
          ],
          "enum": [
            "entity.name.type.enum.tua"
          ],
          "enumMember": [
            "variable.other.enummember.tua"
          ],
          "function.defaultLibrary": [
            "support.function.tua"
          ],
          "namespace.defaultLibrary": [
            "support.variable.namespace.tua"
          ],
          "method": [
            "entity.name.function.member.tua"
          ],
          "property": [
            "variable.other.property.tua"
          ],
          "event": [
            "entity.name.event.tua"
          ],
          "decorator": [
            "storage.type.annotation.tua"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "tua",
        "path": "./snippets/tua.code-snippets"
      }
    ],
    "iconThemes": [
      {
        "id": "tua-icons",
        "label": "tua Icons",
        "path": "./icons/tua-icon-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
