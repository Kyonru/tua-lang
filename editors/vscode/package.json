{
  "name": "tua",
  "displayName": "Tua",
  "description": "Language support for tua, a typed Lua superset for LuaJIT and LOVE projects.",
  "version": "0.4.0",
  "publisher": "SolenodonteLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kyonru/tua-lang.git"
  },
  "homepage": "https://kyonru.github.io/tua-lang",
  "bugs": {
    "url": "https://github.com/Kyonru/tua-lang/issues"
  },
  "icon": "assets/logo.png",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.94.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Tua uses only its bundled language server in Restricted Mode. Trust the workspace before using custom executables or running LOVE.",
      "restrictedConfigurations": [
        "tua.server.path",
        "tua.love.command",
        "tua.love.windowsRuntime",
        "tua.love.macosApp"
      ]
    }
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onCommand:tua.initProject",
    "onCommand:tua.debugLoveProject",
    "onDebugResolve:lua-local",
    "onLanguage:tua",
    "workspaceContains:**/tua.toml",
    "workspaceContains:**/*.tua"
  ],
  "scripts": {
    "build": "esbuild src/extension.js --bundle --minify --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "build:dev": "esbuild src/extension.js --bundle --platform=node --format=cjs --external:vscode --sourcemap --sources-content=true --outfile=dist/extension.js",
    "stage:server": "node scripts/stage-server.js",
    "clean:server": "node scripts/stage-server.js --clean",
    "check": "node ../../scripts/sync-version.js --check && node ../../scripts/generate-config-schema.js --check && node scripts/check-js.js && node --test test/unit/*.test.js scripts/representative-diagnostics-compare.test.js scripts/inline-editor-replay.test.js && node scripts/syntax-grammar-check.js && node scripts/manifest-check.js && node scripts/launch-config-check.js && node scripts/ollama-completion-check.js && node scripts/activation-smoke.js",
    "test:love-debugger": "node scripts/love-debugger-e2e.js",
    "test:vscode": "npm run build && node test/run.js",
    "test:vscode-real": "npm run build && node test/real-server/run.js",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "breakpoints": [
      {
        "language": "tua"
      }
    ],
    "configurationDefaults": {
      "[tua]": {
        "editor.quickSuggestions": {
          "comments": "off",
          "strings": "on",
          "other": "on"
        },
        "editor.quickSuggestionsDelay": 0,
        "editor.suggest.preview": true,
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "tua",
      "properties": {
        "tua.server.path": {
          "type": "string",
          "default": "tua",
          "description": "Path to the tua executable used to launch the language server."
        },
        "tua.love.command": {
          "type": "string",
          "default": "love",
          "description": "Path to the LOVE executable used by Tua: Run LOVE Project and Tua: Debug LOVE Project. The default uses love on PATH and falls back to common platform installs when available."
        },
        "tua.love.windowsRuntime": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Folder of the extracted 64-bit LOVE for Windows (containing love.exe) used by Tua: Package Game to build a fused Windows game. When empty, the command asks for it."
        },
        "tua.love.macosApp": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to love.app used by Tua: Package Game to build a fused macOS game. When empty, /Applications/love.app is used if present, otherwise the command asks for it."
        },
        "tua.trace.server": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "description": "Controls Tua language-server trace messages. Changes apply without restarting when supported by the server."
        },
        "tua.log.verbosity": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "error",
            "info",
            "debug",
            "trace"
          ],
          "description": "Controls Tua language-server log verbosity. Changes apply without restarting when supported by the server."
        },
        "tua.format.indentStyle": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "enum": [
            "spaces",
            "tabs",
            null
          ],
          "description": "Indentation style for the Tua formatter. Null inherits [format].indent_style from tua.toml."
        },
        "tua.format.indentWidth": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "description": "Spaces per indentation level for the Tua formatter. Null inherits [format].indent_width from tua.toml."
        },
        "tua.format.lineWidth": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "description": "Preferred line width for the Tua formatter. Null inherits [format].line_width from tua.toml."
        },
        "tua.format.quoteStyle": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "enum": [
            "preserve",
            "double",
            "single",
            null
          ],
          "description": "Short-string quote style for the Tua formatter. Null inherits [format].quote_style from tua.toml; long-bracket strings are never rewritten."
        },
        "tua.format.lineEnding": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "enum": [
            "lf",
            "crlf",
            "preserve",
            null
          ],
          "description": "Line endings written by the Tua formatter. Null inherits [format].line_ending from tua.toml."
        },
        "tua.format.finalNewline": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Whether the formatter writes a final newline. Null inherits [format].final_newline from tua.toml."
        },
        "tua.diagnostics.rules": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Enable Tua's standard code-quality lint rules. Null inherits [diagnostics].rules from tua.toml."
        },
        "tua.diagnostics.duplicateKeys": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report duplicate table keys."
        },
        "tua.diagnostics.missingRequires": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report literal require and import targets that cannot be resolved."
        },
        "tua.diagnostics.selfAssignments": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report assignments where the target and value are the same symbol."
        },
        "tua.diagnostics.docAnnotations": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report malformed LuaHelper/LuaLS-style documentation annotations."
        },
        "tua.diagnostics.undefinedVariables": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report undefined variables when static analysis can prove them."
        },
        "tua.diagnostics.unusedLocals": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report unused local variables, loop bindings, and direct function declarations. Prefix an intentionally unused binding with `_` to silence it."
        },
        "tua.diagnostics.unusedParameters": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report unused function parameters and unused `...` varargs. Prefix an intentionally unused named parameter with `_` to silence it."
        },
        "tua.diagnostics.useBeforeDefinition": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report provable use of locals before their definition."
        },
        "tua.diagnostics.duplicateParameters": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report duplicate function parameter names as TL4043."
        },
        "tua.diagnostics.badRequires": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report invalid require targets."
        },
        "tua.diagnostics.impossibleBooleanExpressions": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report boolean expressions that can never be true."
        },
        "tua.diagnostics.duplicateIfConditions": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report repeated if or elseif conditions."
        },
        "tua.diagnostics.duplicateBinaryOperands": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report suspicious repeated binary operands."
        },
        "tua.diagnostics.floatEquality": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report direct equality comparisons on numbers."
        },
        "tua.diagnostics.constAssignments": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report assignments to values marked as constant."
        },
        "tua.diagnostics.assignmentArity": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report explicit assignment target/value-count mismatches while preserving Lua multi-return tails."
        },
        "tua.diagnostics.localDeclarationArity": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report explicit local/initializer-count mismatches while preserving Lua multi-return tails."
        },
        "tua.diagnostics.unusedAssignments": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report assignments to locals that are never read afterwards."
        },
        "tua.diagnostics.binaryOperatorTypeMismatches": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report binary operators with statically incompatible operand types."
        },
        "tua.diagnostics.uncalledLocalFunctions": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report local functions that are referenced but never directly called; callback uses still count as uncalled."
        },
        "tua.diagnostics.maxCyclomaticComplexity": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "description": "Report functions whose cyclomatic complexity exceeds this value; zero disables the rule."
        },
        "tua.diagnostics.divideByZero": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report division by a nonzero or dynamic value and a literal zero denominator."
        },
        "tua.diagnostics.almostSwapped": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report consecutive assignments that look like a failed value swap."
        },
        "tua.diagnostics.mixedTables": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report table literals that mix sequential array entries with keyed fields."
        },
        "tua.diagnostics.unknownRecordFields": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Report writes to fields that are absent from a statically known record shape."
        },
        "tua.diagnostics.inlineIgnores": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Enable exact-code diagnostic suppression comments."
        },
        "tua.diagnostics.inlineIgnoreScopes": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          },
          "description": "Allowed exact-code diagnostic suppression directives."
        },
        "tua.diagnostics.inlineIgnoreMaxPerFile": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "description": "Maximum inline diagnostic suppression comments per file; zero is unlimited."
        },
        "tua.diagnostics.globals": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          },
          "description": "Additional global names accepted by diagnostics."
        },
        "tua.jit.enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Enable opt-in LuaJIT shape guidance diagnostics (TL4032-TL4034). Null inherits [jit].enabled from tua.toml."
        },
        "tua.ecs.enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Enable Tua's built-in ECS module, typed APIs, and ECS diagnostics. Null inherits [ecs].enabled from tua.toml."
        },
        "tua.completion.sequenceRanking.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the experimental local contextual sequence ranking lane for completion ordering. Compiler candidates remain the only returned candidates."
        },
        "tua.completion.sequenceRanking.timeoutMs": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 25,
          "description": "Maximum time budget in milliseconds for contextual sequence ranking. Timeout returns the pre-sequence completion ordering."
        },
        "tua.completion.sequenceRanking.maxCandidates": {
          "type": "number",
          "default": 64,
          "minimum": 0,
          "maximum": 500,
          "description": "Maximum number of compiler candidates sent to the contextual sequence ranking lane."
        },
        "tua.completion.multiToken.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the experimental multi-token completion lane. Compiler token completions remain the primary path."
        },
        "tua.completion.multiToken.advanced": {
          "type": "boolean",
          "default": false,
          "description": "Allow multi-token suggestions even when primary compiler completion has normal confidence. When false, suggestions only appear in low-confidence local contexts."
        },
        "tua.completion.multiToken.allowModelIntegration": {
          "type": "boolean",
          "default": false,
          "description": "Explicit opt-in gate for local model-backed inline completions. When enabled, bounded source context is sent to the configured loopback Ollama server."
        },
        "tua.completion.inline.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable deterministic local inline completions from Tua's semantic snippets and source patterns."
        },
        "tua.completion.inline.sources.semantic": {
          "type": "boolean",
          "default": true,
          "description": "Use Tua's unique source-only statement snippets for local inline completion."
        },
        "tua.completion.inline.sources.currentFile": {
          "type": "boolean",
          "default": true,
          "description": "Use repeated lines from the current file for local inline completion."
        },
        "tua.completion.inline.sources.statistical": {
          "type": "boolean",
          "default": false,
          "description": "Experimentally use the local project statistical predictor after deterministic sources abstain. This source is independently off by default and is not quality-approved."
        },
        "tua.completion.ollama.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "scope": "machine",
          "description": "Loopback HTTP endpoint for local Ollama completions. Non-loopback and HTTPS endpoints are rejected."
        },
        "tua.completion.ollama.model": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b-base",
          "scope": "machine",
          "description": "Local Ollama model used for Tua fill-in-the-middle inline completions."
        },
        "tua.completion.ollama.timeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 30000,
          "scope": "machine",
          "description": "Timeout in milliseconds for Ollama inline-completion requests."
        },
        "tua.completion.ollama.keepAlive": {
          "type": "string",
          "default": "10m",
          "scope": "machine",
          "description": "Ollama keep_alive value used to retain the local model in memory."
        },
        "tua.completion.ollama.contextTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 512,
          "maximum": 32768,
          "scope": "machine",
          "description": "Maximum Ollama context window requested for inline completion."
        },
        "tua.completion.ollama.maxTokens": {
          "type": "number",
          "default": 256,
          "minimum": 1,
          "maximum": 512,
          "scope": "machine",
          "description": "Maximum tokens Ollama may generate for one inline completion. Tua uses at most 64 for local expressions and 512 for function bodies."
        },
        "tua.completion.multiToken.maxSuggestions": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "Maximum number of validated multi-token suggestions appended to completion results."
        },
        "tua.fileAssociations": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "lua",
              "tua"
            ]
          },
          "description": "Map glob patterns to language kinds so extra file extensions can be indexed as Lua or tua sources."
        },
        "tua.ignoredPaths": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Path patterns excluded from indexing and diagnostics."
        },
        "tua.requirePathSeparator": {
          "type": "string",
          "default": ".",
          "enum": [
            ".",
            "/"
          ],
          "description": "Separator used when tua suggests require paths."
        },
        "tua.preview.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable experimental sprite-animation and state-machine previews in editor integrations."
        }
      }
    },
