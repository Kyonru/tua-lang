local inspect = require("inspect")
local player = require("player")
local obstacles = require("obstacles")
local background = require("background")
local particles = require("particles")
local score = require("score")
local sound = require("sound")
local friends = require("friends")

local SMOKE: boolean = os.getenv("TUA_LOVE_FULL_SMOKE") == "1"

_HEIGHT = love.graphics.getHeight()
_WIDTH = love.graphics.getWidth()

local clouds_front = love.graphics.newImage("assets/clouds/clouds_front.png")
clouds_front:setFilter("linear", "nearest")
local clouds_back = love.graphics.newImage("assets/clouds/clouds_back.png")
clouds_front:setFilter("linear", "nearest")


function love.load()
  player.load()
  obstacles.load()
  inspect.load()
  particles.load()
  score.load()
  sound.load()
  friends.load()
  background.load(2 / 255, 29 / 255, 53 / 255, 1)
  background.create_infinite_parallax(clouds_back, _HEIGHT / 1.75, 0.5)
  background.create_infinite_parallax(clouds_front, _HEIGHT / 2.4, 1)

  if SMOKE then
    love.update(0.016)
    love.event.quit(0)
  end
end

function love.update(dt: number)
  background.update(dt)
  player.update(dt)
  friends.update(dt)
  obstacles.update(dt)
  inspect.update(dt)
  particles.update(dt)
  score.update(dt)
  sound.update(dt)
end

function love.draw()
  inspect.draw(function()
    particles.draw()
    background.draw()
    player.draw()
    friends.draw()
    obstacles.draw()
    score.draw()
  end)
  _HEIGHT = 1
end

function love.keypressed(key: string)
  inspect.keypressed(key)
  -- uhm i would like properties being a different color
  love.graphics.newImage("")
end

function erica(age: number)
  return age
end

erica(25)

function match(name: string)
  return name
end

match("coller")
