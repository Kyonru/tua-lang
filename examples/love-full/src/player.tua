type Vec2 = {
  x: number,
  y: number,
}

type PlayerModule = {
  sprite?: any,
  x?: number,
  y?: number,
  width?: number,
  height?: number,
  speed?: number,
  velocity?: Vec2,
  max_lives?: number,
  lives?: number,
  drag?: number,
  drag_start_at?: number,
  last_input?: number,
  wind_force?: number,
  bounce_force?: number,
  stop_timer?: number,
  time?: number,
  jetpack?: any,
}

local utils: any = require("utils")
local inspect: any = require("inspect")
local sound: any = require("sound")
local particles: any = require("particles")

local player: PlayerModule = {}

local PLAYER_SPRITES = {
  IDLE = love.graphics.newImage("assets/player/idle.png"),
  LIVE = love.graphics.newImage("assets/player/live.png"),
  DOWN = love.graphics.newImage("assets/player/down.png"),
  UP = love.graphics.newImage("assets/player/up.png"),
  HIT = love.graphics.newImage("assets/player/hit.png"),
  MOVE = love.graphics.newImage("assets/player/move.png"),
  BACK = love.graphics.newImage("assets/player/hit.png"),
}

local font: any = love.graphics.newFont("assets/sniglet.otf", 32)

function player.damage(amount: number, callback: any)
  player.lives -= amount
  if player.lives <= 0 then
    player.lives = 0
    if callback then
      callback()
    end
  end
end

function player.load()
  player.sprite = PLAYER_SPRITES.IDLE
  player.x = 100
  player.y = 100
  player.width = 52
  player.height = 52
  player.speed = 6
  player.velocity = { x = 0, y = 0 }
  player.max_lives = 3
  player.lives = player.max_lives
  player.drag = 0.8
  player.drag_start_at = 0.2
  player.last_input = 0
  player.wind_force = 0.5
  player.bounce_force = 0.25
  player.stop_timer = 0
  player.time = 0
  player.jetpack = particles.create_trail()
end

function player.update(dt: number)
  local left: boolean = love.keyboard.isDown("left")
  local right: boolean = love.keyboard.isDown("right")
  local up: boolean = love.keyboard.isDown("up")
  local down: boolean = love.keyboard.isDown("down")
  local stop: boolean = love.keyboard.isDown("space")

  local no_input: boolean = true

  player.stop_timer -= dt
  player.time += dt

  if player.stop_timer < 0 then
    player.stop_timer = 0
  end

  if stop and player.stop_timer <= 0 then
    player.velocity.x = -player.velocity.x * 0.1
    player.velocity.y = -player.velocity.y * 0.1
    player.stop_timer = 0.5
    sound.play_stop()
  end

  if left then
    player.velocity.x -= player.speed * dt
    player.sprite = PLAYER_SPRITES.BACK
    sound.play_move()
  end

  if right then
    player.velocity.x += player.speed * dt
    player.sprite = PLAYER_SPRITES.MOVE
    sound.play_move()
  end

  if up then
    player.velocity.y -= player.speed * dt
    player.sprite = PLAYER_SPRITES.UP
    sound.play_move()
  end

  if down then
    player.velocity.y += player.speed * dt
    player.sprite = PLAYER_SPRITES.DOWN
    sound.play_move()
  end

  if up or down or left or right or stop then
    no_input = false
  end

  player.x += player.velocity.x
  player.y += player.velocity.y

  if player.x < 0 then
    player.velocity.x = -player.velocity.x * player.bounce_force
    local past_hit: number = player.x
    player.x = 0

    if player.x ~= math.ceil(past_hit) then
      sound.play_bump()
    end
  elseif player.x > _WIDTH - player.width then
    player.velocity.x = -player.velocity.x * player.bounce_force
    local past_hit: number = player.x

    player.x = _WIDTH - player.width

    if player.x ~= math.floor(past_hit) then
      sound.play_bump()
    end
  end

  if player.y < 0 then
    player.velocity.y = -player.velocity.y * player.bounce_force
    local past_hit: number = player.y
    player.y = 0
    if player.y ~= math.ceil(past_hit) then
      sound.play_bump()
    end
  elseif player.y > _HEIGHT - player.height then
    player.velocity.y = -player.velocity.y * player.bounce_force
    local past_hit: number = player.y
    player.y = _HEIGHT - player.height
    if player.y ~= math.floor(past_hit) then
      sound.play_bump()
    end
  end

  if no_input then
    player.last_input += dt
    player.velocity.x -= player.wind_force * dt
  else
    player.last_input = 0
  end

  if player.last_input > player.drag_start_at then
    player.velocity.y = utils.easeOutCirc(player.velocity.y, player.drag)
    player.velocity.x = utils.easeOutCirc(player.velocity.x, player.drag)
  end

  player.jetpack:update(dt)
  player.jetpack:setPosition(player.x + 16, player.y + 32)
end

function player.draw()
  love.graphics.draw(player.jetpack, 0, 0)

  if inspect.inspecting then
    love.graphics.rectangle("line", player.x, player.y, player.width, player.height)
  end

  love.graphics.draw(
    player.sprite,
    player.x,
    player.y,
    0,
    player.width / player.sprite:getWidth(),
    player.height / player.sprite:getHeight(),
    0,
    0
  )

  for i = 1, player.lives do
    love.graphics.draw(
      PLAYER_SPRITES.LIVE,
      8 + (i - 1) * 40,
      16,
      0,
      40 / PLAYER_SPRITES.LIVE:getWidth(),
      40 / PLAYER_SPRITES.LIVE:getHeight()
    )
  end

  local left_x: number = 40 * player.max_lives + 24

  love.graphics.setFont(font)
  if player.stop_timer > 0 then
    love.graphics.print(math.floor((1 - player.stop_timer) * 100) .. "%", left_x, 20)
  else
    local blink: number = math.abs(math.sin(player.time * 2))
    love.graphics.setColor(1, 1, 1, blink)
    love.graphics.print("SPACE", left_x, 20)
    love.graphics.setColor(1, 1, 1, 1)
  end
end

return player
