-- Feature: built-in signal buses for LOVE/gameplay events.
-- `signal()` infers SignalBus, completes methods such as on/emit/off, and
-- emits a bundled tuasignal.lua runtime only when the helper is used.
-- After an event is used, typing in another event-name string suggests it.

local events = signal()
local score = 0

local hitHandler = events:on("player.hit", function(playerName, damage)
  print(playerName .. " took damage", damage)
  score += damage
end)

events:once("game.ready", function()
  print("ready")
end)

events:emit("player.hit", "Ada", 4)
events:emit("game.ready")

local hasHitListeners: boolean = events:has("player.hit")
local listeners = events:listeners("player.hit")

events:off("player.hit", hitHandler)
events:clear("game.ready")

return {
  events = events,
  score = score,
  hasHitListeners = hasHitListeners,
  listenerCount = #listeners,
}
