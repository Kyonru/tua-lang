-- Feature: the built-in tween module wraps flux and is bundled on use.
local banner = { x = -200, alpha = 0 }
local animation = tween.to(banner, 0.6, { x = 40, alpha = 1 })
  :ease("backout")
  :delay(0.1)

local function update(dt: number)
  tween.update(dt)
end

return { banner = banner, animation = animation, update = update }
