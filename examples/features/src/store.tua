-- Feature: explicit typed shared state without an ambient global.
-- The initial table defines completion and checking for every Store method.
type GameState = {
  score: number,
  paused: boolean,
  playerName: string,
}

local game = store({
  score = 0,
  paused = false,
  playerName = "Ada",
})

-- Feature: keyed watchers derive the key and callback value types.
local stopScore = game:watch("score", function(score: number, previous: number, state: GameState)
  print("score", previous, score, state.playerName)
end)

-- Feature: update keeps one state table and notifies after the mutator returns.
game:update(function(state)
  state.score += 10
end)

local state = game:get()
local revision = game:revision()
stopScore()

-- Feature: optional sampled causality presentation using an ordinary store.
local trace = store({
  inspectionKind = "causal-trace/v1",
  epoch = 1,
  enabled = true,
  overwritten = 0,
  events = {
    {
      sequence = 1,
      attackId = 1,
      parentId = 0,
      rootId = 1,
      phase = "processing",
      reason = "primary",
    },
    {
      sequence = 2,
      attackId = 2,
      parentId = 1,
      rootId = 1,
      phase = "suppressed",
      reason = "root_limit",
    },
  },
})

return {
  trace = trace,
  game = game,
  -- Go to Definition on state.score opens the initial store field above.
  score = state.score,
  revision = revision,
}
