-- Feature: ShaderScan reloads a shader when the file changes, preserving the
-- last working shader if a development edit fails to compile.
-- Paths are relative to the running game root. Build copies src/assets to
-- build/assets, so this same path works in source and generated games.
local shaders = ShaderScan.new()
local elapsed = 0

-- Restore uniforms on the compiled candidate before it replaces the old shader.
shaders.on_compiled = function(
  name: string,
  path: string,
  replacement: Shader,
  previous: Shader | nil
)
  if name == "wave" then
    replacement:send("time", elapsed)
  end
end

local function load()
  shaders:load_shader("wave", "assets/wave.glsl")
end

local function update(dt: number)
  elapsed += dt
  shaders:update(dt)
  local wave = shaders.s.wave
  if wave then
    wave:send("time", elapsed)
  end
end

local function draw()
  local wave = shaders.s.wave
  if not wave then
    return
  end
  love.graphics.setShader(wave)
  love.graphics.rectangle("fill", 0, 0, 320, 180)
  love.graphics.setShader()
end

return { shaders = shaders, load = load, update = update, draw = draw }
