-- Feature: built-in ECS support with no require or project setup.
-- Components are reusable data shapes, entities are numeric IDs, and systems
-- update every entity that has a requested set of components.

-- Feature: typed component schemas use simple string type names.
-- The ECS analyzer checks one-line schemas and matching world:add values.
local Position = ecs.component("Position", { x = "number", y = "number" })
local Velocity = ecs.component("Velocity", { x = "number", y = "number" })
local Sprite = ecs.component("Sprite", { image = "Image" })

-- Feature: ECS API completion, hover, signature help, and diagnostics.
-- Hover world to see EcsWorld. Type world:a to complete add.
local world = ecs.world()
local player = world:create()

world:add(player, Position, { x = 120, y = 80 })
world:add(player, Velocity, { x = 30, y = 0 })
world:add(player, Sprite, { image = image "assets/player.png" })

-- Feature: typed query/system component lists.
-- Unknown components or empty lists produce ECS domain diagnostics.
local movingSprites = world:query({ Position, Velocity, Sprite })
local movementSystem = ecs.system(world, { Position, Velocity }, function(_, position, velocity, dt)
  position.x += velocity.x * dt
  position.y += velocity.y * dt
end)

-- A LOVE update callback can call this with its dt value.
movementSystem:update(1 / 60)

return {
  Position = Position,
  Velocity = Velocity,
  Sprite = Sprite,
  world = world,
  player = player,
  movementSystem = movementSystem,
}
