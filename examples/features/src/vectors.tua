-- Feature: built-in LOVE-friendly Vec2 type.
-- `Vec2` is available without declaring a local alias.
local position: Vec2 = vec2(100, 200)
local velocity = vec2(12, -4)

-- Feature: Vec2 fields are typed as numbers.
-- Completion after `position.` should offer `x` and `y`, and hover should show
-- both fields as number.
local nextX: number = position.x + velocity.x
local nextY: number = position.y + velocity.y

-- Feature: vec2 emits BrineVector-backed Lua.
-- Generated Lua lowers vec2(a, b) to a cached `require("brinevector")`
-- constructor. `tua build` writes brinevector.lua into the output folder when
-- needed.
local function move(point: Vec2, delta: Vec2): Vec2
  return vec2(point.x + delta.x, point.y + delta.y)
end

-- Feature: BrineVector properties and operators are modeled conservatively.
local speed: number = velocity.length
local direction: Vec2 = velocity.normalized
local movedByOperator: Vec2 = position + velocity
local distanceSquared: number = position:dot(velocity)

local moved = move(position, velocity)

return {
  position = position,
  velocity = velocity,
  nextX = nextX,
  nextY = nextY,
  speed = speed,
  direction = direction,
  movedByOperator = movedByOperator,
  distanceSquared = distanceSquared,
  move = move,
  moved = moved,
}
