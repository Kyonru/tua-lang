-- Feature: optimized class syntax lowers to portable Lua metatables.
-- `open` allows inheritance; plain/final classes cannot be extended.
open class Entity {
  x: number
  y: number

  init(x: number, y: number) {
    self.x = x
    self.y = y
  }

  update(dt: number) {
  }
}

-- `final` is an optimization contract: known calls to final methods can lower
-- to direct local function calls instead of virtual table dispatch.
final class Particle extends Entity {
  speed: number = 120

  init(x: number, y: number) {
    super(x, y)
  }

  override final update(dt: number) {
    self.x += self.speed * dt
  }
}

local particle = Particle.new(10, 20)
particle.update(0.016)
particle:update(0.016)

if particle is Entity then
  particle.x = particle.x + 1
end

return {
  particle = particle,
}
