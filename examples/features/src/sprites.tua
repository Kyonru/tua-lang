-- Feature: experimental sprite sheet helper.
-- First-class sprite analysis validates the image path and animation metadata,
-- then build output lowers this normal Tua call to readable anim8-backed Lua.
-- `tua build` writes bundled anim8.lua when generated Lua requires it.
local Player = spriteSheet({
  image = "assets/player.png",
  frame = { width = 128, height = 128, left = 0, top = 0, border = 0 },
  origin = { x = 64, y = 128 },
  animations = {
    orange = { column = 1, row = 0, durations = 1 },
    blue = {
      frames = {
        { from = 0, to = 3, row = 1 },
        { from = 0, to = 1, row = 2 },
      },
      fps = 8,
      onLoop = "pauseAtEnd",
      markers = { { frame = 2, name = "accent" } },
    },
    green = {
      from = 0,
      to = 3,
      row = 2,
      frame = { width = 64, height = 64, left = 4, top = 8, border = 1 },
      durations = { 0.1, 0.5, 0.1, 0.1 },
      onLoop = function(animation, loops)
        if loops > 1 then
          animation:pause()
        end
      end,
    },
  },
})

local preview = Player:player("orange")
preview:gotoAndStop("blue", 3)
preview:on("accent", function(player, marker, animation, frame)
  print(marker, animation, frame)
end)

return {
  Player = Player,
  preview = preview,
}
