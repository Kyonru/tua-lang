-- Feature: opt-in typed bounded FIFO with snapshot-bounded drains.

type Event = { amount: number }
local initial: Event[] = {}
local pending = BoundedQueue.new(8, initial)
local total = 0

assert(pending.push({ amount = 12 }))
assert(pending.push({ amount = 3 }))
pending.drain(8, function(event)
  total += event.amount
end)
assert(total == 15 and pending.count() == 0)

return { total = total }
