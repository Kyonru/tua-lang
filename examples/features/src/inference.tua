type Vec2 = {
  x: number,
  y: number,
}

type Player = {
  name: string,
  pos: Vec2,
  hp: number,
  alive: boolean,
}

local function makePlayer(name: string)
  return {
    name = name,
    pos = { x = 0, y = 0 },
    hp = 100,
    alive = true,
  }
end

local function makeTypedPlayer(name: string): Player
  return {
    name = name,
    pos = { x = 1, y = 2 },
    hp = 80,
    alive = true,
  }
end

local function move(player: Player, delta: Vec2): Player
  player.pos.x += delta.x
  player.pos.y += delta.y

  return player
end

local function incomplete(value: string)
  return value
end

local function startingHp()
  return 100
end

function statusText(alive: boolean)
  return "ready"
end

local inferredNumber = 42
local inferredString = "inferred"
local inferredBoolean = true
local inferredNil = nil
local inferredTable = {
  label = "literal table",
  count = 2,
  enabled = true,
}

-- Feature: stable inferred local contracts.
-- Literal declarations widen to their ordinary primitive type, and compatible
-- reassignments keep that contract across control-flow joins.
inferredNumber = 64
inferredString = "still a string"

-- Delayed initialization is explicit because an unannotated `nil` local keeps
-- the inferred type `nil`.
local delayedScore: number | nil = nil
delayedScore = 100

-- `any` remains the intentional escape hatch for values that change shape.
local dynamicState: any = 1
dynamicState = "runtime state"

-- Feature: array and index inference.
-- Hover/inlay should infer `scores` as number[] and `firstScore` as number.
local scores = { 10, 20, 30 }
local firstScore = scores[1]

-- Feature: record string-key indexing.
-- Bracket access with a known string key keeps the field value type.
local scoreRecord = { name = "Ada", score = 10 }
local scoreFromRecord = scoreRecord["score"]

-- Feature: numeric loop variable and indexed array access.
-- The loop index is number, and scores[index] keeps the array element type.
for index = 1, #scores do
  local scoreFromLoop = scores[index]
end

-- Feature: ipairs loop variable inference.
-- `value` is inferred from the array element type.
for _, value in ipairs(scores) do
  local doubledScore = value + 1
end

-- Feature: pairs loop variable inference.
-- Keys and values are inferred from known record fields when the table is static.
for key, value in pairs(scoreRecord) do
  local knownKey: "name" | "score" = key
  local knownValue: string | number = value
end

local inferredPlayer = makePlayer("Inferred")
local typedPlayer: Player = makeTypedPlayer("Typed")
local inferredHp = typedPlayer.hp
local inferredX = typedPlayer.pos.x
local inferredStart = startingHp()
local inferredStatus = statusText(typedPlayer.alive)
local movedPlayer = move(typedPlayer, { x = 3, y = 4 })

local Legacy = require("legacy")
local legacyMessage = Legacy.describe("hp", inferredHp)

local dynamicValue = {
  deep = {
    field = "unchecked dynamic value",
  },
}
local innferenceFromDynamic = dynamicValue.deep.field

return {
  inferredNumber = inferredNumber,
  inferredString = inferredString,
  inferredBoolean = inferredBoolean,
  inferredNil = inferredNil,
  inferredTable = inferredTable,
  delayedScore = delayedScore,
  dynamicState = dynamicState,
  scores = scores,
  firstScore = firstScore,
  scoreRecord = scoreRecord,
  scoreFromRecord = scoreFromRecord,
  inferredPlayer = inferredPlayer,
  typedPlayer = typedPlayer,
  inferredHp = inferredHp,
  inferredX = inferredX,
  inferredStart = inferredStart,
  inferredStatus = inferredStatus,
  movedPlayer = movedPlayer,
  legacyMessage = legacyMessage,
  innferenceFromDynamic = innferenceFromDynamic,
}
