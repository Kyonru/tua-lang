local Functions = require("functions")
local Compound = require("compound")
local Legacy = require("legacy")

local player = Functions.makePlayer("Lua interop")
Functions.damage(player, 7)

local clamped = Legacy.clamp(Compound.stats.score, 0, 100)
local message = Legacy.describe("score", clamped)

local built_in = tostring(1)

local function macarrons()
  return Functions.makePlayer("lua interop")
end

local function make_function()
  return Functions.makePlayer
end

local function recursive(a: string)
  if a == tostring(1) then
    return 1
  end

  if a == tostring(2) then
    return "value"
  end

  return recursive(a+1)
end

return {
  player = player,
  stats = Compound.stats,
  clamped = clamped,
  message = message,
  built_in = built_in,
}

