-- Feature: aliases and functions preserve concrete types at each use.
type Box<T> = { value: T }

local function identity<T>(value: T): T
  return value
end

local count: Box<number> = { value = identity(3) }
local label: Box<string> = { value = identity("ready") }

-- Feature: generic class constructor arguments infer instance field types.
final class Pair<K, V> {
  first: K
  second: V

  init(first: K, second: V) {
    self.first = first
    self.second = second
  }
}

local pair = Pair.new(count.value, label.value)
local first: number = pair.first
local second: string = pair.second

return { count = count, label = label, pair = pair, first = first, second = second }
