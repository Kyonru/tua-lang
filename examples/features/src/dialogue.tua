-- Feature: typed headless dialogue; rendering, input and timing belong to the host.

local function createPlayer()
  return Dialogue.new({
    entry = "welcome",
    nodes = {
      welcome = { kind = "line", text = "Ready?", next = "reply" },
      reply = {
        kind = "choice",
        options = { { id = "yes", text = "Ready.", target = "finish" } },
      },
      finish = { kind = "end" },
    },
  }, { history = { capacity = 16, maxBytes = 8192 } })
end

-- History stores the presented line and accepted reply; browsing has no effects.
local function historyExample()
  local player = createPlayer()
  player:start()
  player:advance()
  player:choose("yes")
  local history = player:history()
  assert(#history.entries == 2)
  assert(history.entries[2].choiceId == "yes")
  player:redactHistory(history.entries[1].id)
  player:clearHistory()
  player:dispose()
  return history
end

return { createPlayer = createPlayer, historyExample = historyExample }
