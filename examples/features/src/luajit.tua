-- Feature: LuaJIT guidance is opt-in through [jit].
-- When [jit].enabled = true, Tua warns about patterns that can make hot
-- LuaJIT paths harder to optimize. The default feature example keeps the mode
-- disabled, so this file still checks and builds as ordinary Tua.

-- Feature: inferred local types are stable independently of JIT guidance.
local value = 1
value = 2

-- Feature: TL4033 reports late table fields and field type drift in JIT mode.
local player = { hp = 10 }
player.name = "late field when JIT guidance is enabled"

-- Feature: TL4034 points out dynamic table writes inside loops in JIT mode.
for i = 1, 3 do
  player[i] = i
  local i = 10
  print(i)
end

-- Feature: any remains the deliberate escape hatch for dynamic Lua values.
local dynamic: any = 1
dynamic = "allowed"

return {
  value = value,
  player = player,
  dynamic = dynamic,
}
