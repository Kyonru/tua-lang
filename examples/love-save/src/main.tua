local Session = require("session")
local session = Session.new()
local heading = love.graphics.newFont(28)
local body = love.graphics.newFont(18)
function love.update(dt: number) session.update(dt) end
function love.keypressed(key: string)
  if session.ui.confirmReset then
    if key == "return" then session.confirmReset()
    elseif key == "escape" then session.cancelReset() end
    return
  end
  if key == "space" then session.score()
  elseif key == "s" then session.save()
  elseif key == "r" then session.acceptRecovery()
  elseif key == "d" then session.requestReset()
  elseif key == "escape" then love.event.quit() end
end
function love.draw()
  local width = love.graphics.getWidth()
  love.graphics.clear(0.08, 0.12, 0.14)
  love.graphics.setColor(0.94, 0.92, 0.85)
  love.graphics.setFont(heading)
  love.graphics.print("Save and resume a run", 32, 32)
  love.graphics.setFont(body)
  local issue = session.issue()
  if issue and issue.code ~= "damaged_slot_unverified" then
    love.graphics.print("Saved progress could not be loaded.", 32, 92)
  else
    love.graphics.print("Score: " .. session.snapshot().score, 32, 92)
  end
  if session.ui.confirmReset then
    love.graphics.printf("Delete saved progress and start again? Both save copies will be removed.",
      32, 150, width - 64)
    love.graphics.print("Enter   Delete and restart     Esc   Keep progress", 32, 250)
    love.graphics.printf(session.ui.notice, 32, 310, width - 64)
  else
    love.graphics.printf(session.ui.notice, 32, 150, width - 64)
    if issue then
      love.graphics.print("Saving is paused until you choose what to do.", 32, 250)
      if issue.code == "damaged_slot_unverified" then
        love.graphics.print("R   Use recovered progress (it may be older)", 32, 292)
      else
        love.graphics.print(
          "Keep these files for backup or try a compatible game version.",
          32,
          292
        )
      end
    else
      love.graphics.print("Space   Earn a point     S   Save now", 32, 250)
      love.graphics.print(
        "Changes autosave after a quiet second. Close and reopen to resume.",
        32,
        292
      )
    end
    love.graphics.setColor(0.69, 0.80, 0.79)
    love.graphics.print("D   Reset save…     Esc   Quit", 32, 380)
  end
end
function love.quit()
  if not session.dispose() then
    print("Save on quit was blocked or failed; save files were not reset.")
  end
  heading:release()
  body:release()
end
return session
