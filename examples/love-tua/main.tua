import type Shared from "./types"
local Globals = require('global')
local ECS = require('ecs')
local Renderer = require("renderer")
local feel = require("lib.feel")

local flow = Globals.flow
local world = ECS.world
local movement = ECS.movement

local controller = input({
  controls = {
    left = { "key:left", "key:a", "axis:leftx-" },
    right = { "key:right", "key:d", "axis:leftx+" },
    up = { "key:up", "key:w", "axis:lefty-" },
    down = { "key:down", "key:s", "axis:lefty+" },
    confirm = { "key:return", "button:a" },
    pause = { "key:escape", "key:p" },
    shoot = {
      "key:space", "button:b"
    }
  },
  pairs = {
    move = { "left", "right", "up", "down" },
  },
  deadzone = 0.25,
})

local function onRingSpawned()
  local wave = Renderer.spawnRing()
  Globals.game:update(function(state: Shared.GameState)
    state.shots += #wave
    state.score += 10
  end)
  feel.play("player.fire")
end

function love.load(arg, unfilteredArg)
  feel.define("player.fire", { duration = 0.14, strength = 1 })

  -- CI opens a real LOVE process, exercises every mixed-source dependency,
  -- and exits instead of relying on a rendering screenshot.
  if os.getenv("TUA_LOVE_TUA_SMOKE") == "1" then
    onRingSpawned()
    controller:update()
    movement:update(1 / 60)
    Renderer.updateBullets(1 / 60)
    feel.update(1 / 60)

    if Globals.game:get().shots ~= 8 or Globals.bullets:activeCount() ~= 8 then
      error("Tua LOVE showcase did not initialize")
    end

    love.event.quit(0)
  end
end

function love.update(dt)
  controller:update()

  if controller:pressed("pause") then
    if flow:is("playing") then
      flow:pause()
    elseif flow:is("paused") then
      flow:resume()
    end
  end

  if not flow:is("playing") then
    feel.update(dt)
    return
  end

  local moveX, moveY = controller:get("move")
  local velocity = world:get(ECS.player, ECS.VelocityComponent)
  velocity.x = moveX * 220
  velocity.y = moveY * 220
  movement:update(dt)

  if controller:pressed("shoot") then
    onRingSpawned()
  end

  Renderer.updateBullets(dt)

  feel.update(dt)
end

function love.draw()
  local flash = feel.amount("player.fire")
  love.graphics.clear(0.035 + flash * 0.08, 0.045, 0.075, 1)

  Renderer.drawBullets()
  Renderer.drawPlayer()

  local state = Globals.game:get()
  love.graphics.setColor(0.92, 0.94, 1, 1)
  love.graphics.print("score " .. state.score .. "   shots " .. state.shots, 16, 14)
  love.graphics.print("move: arrows/WASD   fire: space/Z   pause: escape/P", 16, 446)

  if flow:is("paused") then
    love.graphics.printf("PAUSED", 0, 220, 720, "center")
  end

end
