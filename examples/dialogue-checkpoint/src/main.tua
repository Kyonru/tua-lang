local scene = require("scene")
local options = { checkpointVersion = "harbor-v1", locale = "en" }
local player = Dialogue.new(scene, options)
player:start()
assert(#player:update(0.25, false) == 1)
local saved = player:checkpoint()
local restored = Dialogue.new(scene, options)
restored:restore(saved)
assert(restored:snapshot().revealComplete)
assert(#restored:update(0, true) == 0)
assert(restored:advance())
local choice = restored:checkpoint()
local choosing = Dialogue.new(scene, options)
choosing:restore(choice)
assert(choosing:choose("checkpoint.wait"))
choosing:update(0.5, false)
assert(choosing:suspend())
local waiting = Dialogue.new(scene, options)
waiting:restore(choosing:checkpoint())
waiting:update(10, false)
assert(waiting:snapshot().state == "waiting")
assert(waiting:resume())
waiting:update(1.5, false)
assert(waiting:snapshot().nodeId == "done")
player:dispose()
restored:dispose()
choosing:dispose()
waiting:dispose()
print("dialogue checkpoint round trips passed")

assert(require("context_demo"))

assert(require("forward_demo"))
