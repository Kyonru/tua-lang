local model = require("state")
local title = love.graphics.newFont(30)
local body = love.graphics.newFont(18)
function love.load()
  love.window.setMode(800, 480)
  love.window.setTitle("Tua: a pause menu and game flow")
end
function love.update(dt: number)
  model.update(dt)
end
function love.focus(focused: boolean)
  model.focus(focused)
end
function love.keypressed(key: string)
  if key == "escape" and model.flow:is("title") then
    love.event.quit()
  end
end
function love.draw()
  love.graphics.clear(0.08, 0.12, 0.14)
  love.graphics.setColor(0.94, 0.92, 0.85)
  love.graphics.setFont(title)
  if model.flow:is("title") then
    love.graphics.print("A short crossing", 32, 48)
    love.graphics.setFont(body)
    love.graphics.print("Press Enter or Space to begin.", 32, 108)
    love.graphics.print("Escape to quit", 32, 418)
    return
  end
  love.graphics.print(model.flow:is("paused") and "Paused" or "On the move", 32, 48)
  love.graphics.setFont(body)
  love.graphics.print("Shots: " .. model.state.shots, 32, 104)
  love.graphics.print("Time: " .. string.format("%.1f", model.state.gameplayTime), 32, 132)
  love.graphics.setColor(0.67, 0.79, 0.75)
  love.graphics.circle("fill", 48 + model.marker.x, 248, 12)
  love.graphics.setColor(0.94, 0.92, 0.85)
  if model.flow:is("paused") then
    love.graphics.print("Enter / Space / Esc   Resume", 32, 324)
    love.graphics.print("R   Restart     Backspace   Title", 32, 358)
  else
    love.graphics.print("Space   Fire     Esc   Pause", 32, 358)
    love.graphics.print("R   Restart     Backspace   Title", 32, 392)
  end
  -- This small pause caption uses UI time, even while the world is frozen.
  love.graphics.setColor(0.67, 0.79, 0.75, model.menu.opacity)
  love.graphics.print("Take your time.", 32, 188)
end
function love.quit()
  title:release()
  body:release()
end
return model
