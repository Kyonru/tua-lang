local actions = require("forward")
local scene = require("scene")
local coins = 10
local player = actions.new(scene, {
  handlers = {
    purchase = function(payload: { item: string }): boolean
      if payload.item ~= "shell" or coins < 5 then
        return false
      end
      coins -= 5
      return true
    end,
  },
})
player:start()
assert(player:snapshot().state == "awaiting_action")
assert(coins == 10)
assert(player:runAction())
assert(coins == 5)
assert(player:snapshot().nodeId == "done")
player:dispose()
print("registered dialogue action passed")

local context = require("context")
local bound = require("bound")
local contextual = context.new(bound, { allowed = true }, {
  handlers = {
    purchase = function(payload: { item: string }): boolean
      return payload.item == "shell"
    end,
  },
})
contextual:start()
assert(contextual:runAction())
assert(contextual:snapshot().nodeId == "yes")
contextual:dispose()

-- The host may settle asynchronous work later, without advancing inside callbacks.
local pending = Dialogue.actionHandle()
local waiting = actions.new(scene, {
  handlers = {
    purchase = function(payload: { item: string })
      assert(payload.item == "shell")
      return pending
    end,
  },
})
waiting:start()
assert(waiting:runAction())
local request = waiting:snapshot().action
assert(request ~= nil)
assert(request.status == "pending")
assert(not waiting:runAction())
assert(pending:resolve(true))
assert(waiting:snapshot().state == "awaiting_action")
assert(waiting:runAction())
assert(waiting:snapshot().nodeId == "done")
waiting:dispose()
print("asynchronous dialogue action passed")

-- Authored waits use dialogue time; suspended frames do not count.
local waitScene = require("wait")
local timed = Dialogue.new(waitScene)
timed:start()
timed:update(0.25, false)
assert(timed:suspend())
assert(timed:snapshot().suspended)
timed:update(20, false)
assert(timed:snapshot().state == "waiting")
assert(timed:resume())
timed:update(0.25, false)
assert(timed:snapshot().nodeId == "done")
timed:dispose()
print("dialogue waits and suspension passed")

-- Host-selected conversation skip respects pending external work.
require("skip-demo")

assert(require("checkpoint-demo"))
