-- Optional host policy, one instance per player. Never skips to an action target.
type Request = { generation: number, visit: number, nodeId: string }
type ActionView = { status: "ready" | "pending" | "resolved" | "rejected" | "cancelled" }
type View = {
  generation: number,
  visit: number,
  nodeId?: string,
  suspended: boolean,
  state: string,
  action?: ActionView,
}
type Player = { snapshot: (self: any) -> View, cancel: (self: any) -> boolean }
local function new()
  local owner: Player | nil = nil
  local function bind(player: Player)
    assert(owner == nil, "skip policy already bound")
    owner = player
  end
  local generation = -1
  local visit = -1
  local nodeId = ""
  local cancellable = false
  local function begin(request: Request, cancel?: () -> nil)
    assert(owner ~= nil, "bind skip policy before dispatch")
    generation = request.generation
    visit = request.visit
    nodeId = request.nodeId
    -- Supplying cleanup explicitly declares that the external work can stop.
    cancellable = cancel ~= nil
    return Dialogue.actionHandle({ cancel = cancel })
  end
  local function skipConversation(): (boolean, string)
    local player = owner
    if player == nil then
      return false, "unbound"
    end
    local view = player:snapshot()
    if view.suspended then
      return false, "suspended"
    end
    if view.state == "awaiting_action" then
      local action = view.action
      if action == nil or action.status == "ready" then
        return false, "action_not_started"
      end
      if action.status ~= "pending" then
        return false, "consume_action_result"
      end
      if view.generation ~= generation or view.visit ~= visit or view.nodeId ~= nodeId then
        return false, "unowned_action"
      end
      if not cancellable then
        return false, "non_cancellable_action"
      end
    end
    -- Player cancellation detaches the handle before cleanup. A reentrant
    -- restart wins; no further navigation or manufactured result follows it.
    if player:cancel() then
      return true, "cancelled"
    end
    return false, "inactive"
  end
  return { bind = bind, begin = begin, skipConversation = skipConversation }
end
return { new = new }
