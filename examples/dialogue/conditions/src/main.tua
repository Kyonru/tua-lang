local context = require("context")
local scene = require("scene")
local player = context.new(scene, { coins = 5, unlocked = true }, { transitionBudget = 8 })
player:start()
assert(player:snapshot().nodeId == "shop")
assert(#player:update(0, false) == 1)
assert(player:advance())
local choices = player:snapshot().node
assert(choices and #choices.options == 2)
assert(choices and choices.options[1].enabled == false)
assert(choices and choices.options[1].reason == "Requires 20 coins; you have 5.")
assert(not player:choose("shop.buy"))
assert(not player:choose("shop.bonus"))

player:updateContext({ coins = 25, unlocked = true })
local refreshed = player:snapshot().node
assert(refreshed and refreshed.options[1].enabled == true)
player:updateContext({ coins = 0, unlocked = false })
assert(player:snapshot().nodeId == "locked")
assert(not player:choose("shop.buy"))
player:start("loop")
local fault = player:snapshot()
assert(fault.state == "faulted")
assert(fault.issue and fault.issue.code == "transition_budget_exceeded")
player:start("done")
assert(player:snapshot().issue == nil)
player:dispose()
print("dialogue conditions example passed")
