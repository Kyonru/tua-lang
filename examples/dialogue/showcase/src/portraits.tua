-- Bundled DiceBear Lorelei images; the host still owns portrait backgrounds and lifetime.
local function new()
  local images: { [string]: Image } = {}
  local disposed = false
  for _, id in ipairs({
    "mara",
    "mara.happy",
    "mara.worried",
    "mara.resolved",
    "ivo",
    "ivo.happy",
    "ivo.worried",
    "beacon",
  }) do
    local image = love.graphics.newImage("assets/portraits/" .. id .. ".png")
    image:setFilter("linear", "linear")
    images[id] = image
  end
  local function draw(id: string, expression: string, x: number, y: number, size: number)
    if disposed then return end
    local image = images[id]
    if image == nil then return end
    love.graphics.push("all")
    love.graphics.translate(x, y)
    love.graphics.scale(size / 120, size / 120)
    love.graphics.setColor(0.21, 0.29, 0.32)
    love.graphics.rectangle("fill", 0, 0, 120, 120, 3, 3)
    love.graphics.setColor(0.67, 0.72, 0.65)
    love.graphics.circle("fill", 64, 49, 40)
    love.graphics.setColor(1, 1, 1)
    love.graphics.draw(image, 0, 0, 0, 120 / image:getWidth(), 120 / image:getHeight())
    love.graphics.pop()
  end
  local function dispose()
    if disposed then return end
    disposed = true
    for _, image in pairs(images) do image:release() end
    images = {}
  end
  return { draw = draw, dispose = dispose }
end
return { new = new }
