-- A reading surface for the player's bounded, plain-text history.
export type Entry = { speaker?: string, kind?: string, text: string }
local function new()
  local heading = love.graphics.newFont("assets/fonts/lora.ttf", 24)
  local body = love.graphics.newFont("assets/fonts/manrope.ttf", 18)
  local label = love.graphics.newFont("assets/fonts/manrope.ttf", 13)
  local function draw(entries: Entry[], scroll: number):(number, number)
    local width, height = love.graphics.getDimensions()
    local x = 32
    local y = 118
    local w = width - 64
    local h = height - 172
    local top = y + 76
    local viewport = h - 140
    local textWidth = w - 80
    local rows: { entry: Entry, height: number }[] = {}
    local total = 0
    for _, entry in ipairs(entries) do
      local _, lines = body:getWrap(entry.text, textWidth)
      local rowHeight = 30 + #lines * body:getHeight() + 28
      rows[#rows + 1] = { entry = entry, height = rowHeight }
      total += rowHeight
    end
    local maximum = math.max(0, total - viewport)
    scroll = math.max(0, math.min(scroll, maximum))
    love.graphics.setColor(0.035, 0.055, 0.065, 0.82)
    love.graphics.rectangle("fill", 0, 0, width, height)
    love.graphics.setColor(0.075, 0.105, 0.12)
    love.graphics.rectangle("fill", x, y, w, h, 6, 6)
    love.graphics.setColor(0.94, 0.92, 0.85)
    love.graphics.setFont(heading)
    love.graphics.print("Recent conversation", x + 24, y + 17)
    love.graphics.setFont(label)
    love.graphics.setColor(0.65, 0.74, 0.73)
    love.graphics.print(tostring(#entries) .. " remembered passages", x + 24, y + 49)
    love.graphics.printf("TAB  Close", x + 24, y + 25, w - 48, "right")
    love.graphics.intersectScissor(x + 24, top, w - 48, viewport)
    local cursor = top - scroll
    if #rows == 0 then
      love.graphics.setFont(body)
      love.graphics.printf("Nothing here yet. Continue the conversation to begin your record.",
        x + 40, top + 16, textWidth)
    end
    for _, row in ipairs(rows) do
      love.graphics.setColor(0.76, 0.68, 0.44)
      love.graphics.rectangle("fill", x + 24, cursor + 3, 2, 15)
      love.graphics.setFont(label)
      love.graphics.print(
        row.entry.kind == "choice" and "Your reply" or (row.entry.speaker or "Narration"),
        x + 40,
        cursor
      )
      love.graphics.setColor(0.94, 0.92, 0.85)
      love.graphics.setFont(body)
      love.graphics.printf(row.entry.text, x + 40, cursor + 26, textWidth)
      cursor += row.height
    end
    love.graphics.setScissor()
    if maximum > 0 then
      love.graphics.setColor(0.22, 0.29, 0.30)
      love.graphics.rectangle("fill", x + w - 12, top, 2, viewport)
      local thumb = math.max(24, viewport * viewport / total)
      love.graphics.setColor(0.76, 0.68, 0.44)
      love.graphics.rectangle(
        "fill",
        x + w - 12,
        top + (viewport - thumb) * scroll / maximum,
        2,
        thumb
      )
    end
    love.graphics.setFont(label)
    for index = 1, 2 do
      local enabled = index == 1 and scroll > 0 or index == 2 and scroll < maximum
      local bx = index == 1 and x + 24 or x + w - 136
      love.graphics.setColor(
        enabled and 0.20 or 0.11,
        enabled and 0.28 or 0.15,
        enabled and 0.29 or 0.17
      )
      love.graphics.rectangle("fill", bx, height - 100, 112, 32, 4, 4)
      love.graphics.setColor(
        enabled and 0.94 or 0.46,
        enabled and 0.92 or 0.54,
        enabled and 0.85 or 0.54
      )
      love.graphics.printf(index == 1 and "[  Older" or "Newer  ]", bx, height - 92, 112, "center")
    end
    return maximum, scroll
  end
  local function click(x: number, y: number): number
    local width, height = love.graphics.getDimensions()
    if y < height - 100 or y > height - 68 then return 0 end
    if x >= 56 and x <= 168 then return -1 end
    if x >= width - 168 and x <= width - 56 then return 1 end
    return 0
  end
  local function dispose()
    heading:release()
    body:release()
    label:release()
  end
  return { draw = draw, click = click, dispose = dispose }
end
return { new = new }
