local Controller = require("controller")
local Backend = require("backend")
local Presenter = require("presenter")
local Theme = require("theme")
local Styles = require("styles")
local Transcript = require("transcript")
local transcript = Transcript.new()
local Staging = require("staging_layout")
local host = Controller.new(Backend.new(), Backend.new())
local presenter = Presenter.new()
local title = love.graphics.newFont("assets/fonts/lora.ttf", 32)
local caption = love.graphics.newFont("assets/fonts/manrope.ttf", 13)
local maxScroll = 0
local maxHistoryScroll = 0
function love.update(dt: number)
  host.update(dt)
  if not host.settings.paused then presenter.update(dt) end
end
function love.keypressed(key: string)
  local settings = host.settings
  if key == "h" then settings.help = not settings.help
  elseif key == "tab" then settings.transcript = not settings.transcript
  elseif key == "o" then
    if settings.portrait == "left" then settings.portrait = "right"
    elseif settings.portrait == "right" then settings.portrait = "above"
    elseif settings.portrait == "above" then settings.portrait = "none"
    else settings.portrait = "left" end
  elseif key == "f4" then
    settings.entry = settings.entry == "staging" and "start" or "staging"
    settings.mode = "bubble"
    host.reset()
  elseif key == "f3" then
    settings.entry = settings.entry == "rich" and "start" or "rich"
    host.reset()
  elseif key == "f2" then
    settings.entry = settings.entry == "start" and "quick" or "start"
    host.reset()
  elseif key == "g" then
    local facts = host.player():getContext()
    host.player():updateContext({ name = facts.name, permit = not facts.permit })
  elseif key == "space" or key == "return" then
    if not settings.help and not settings.transcript then host.advance() end
  elseif key == "1" then settings.mode = "panel"
  elseif key == "2" then settings.mode = "bubble"
  elseif key == "3" then settings.mode = "radio"
  elseif key == "4" then settings.mode = "subtitles"
  elseif key == "5" then settings.mode = "mythic"
  elseif key == "6" then settings.mode = "tactics"
  elseif key == "7" then settings.mode = "terminal"
  elseif key == "up" or key == "down" then
    local snapshot = host.player():snapshot()
    local node = snapshot.node
    if snapshot.state == "awaiting_choice" and node and #node.options > 0 then
      local direction = key == "up" and -1 or 1
      settings.selected = math.max(1, math.min(#node.options, settings.selected + direction))
    end
  elseif key == "[" or key == "pageup" then
    if settings.transcript then settings.historyScroll = math.max(0, settings.historyScroll - 58)
    else settings.scroll = math.max(0, settings.scroll - 58) end
  elseif key == "]" or key == "pagedown" then
    if settings.transcript then
      settings.historyScroll = math.min(maxHistoryScroll, settings.historyScroll + 58)
    else settings.scroll = math.min(maxScroll, settings.scroll + 58) end
  elseif key == "f" then settings.speed = settings.speed == 1 and 3 or 1
  elseif key == "m" then settings.reducedMotion = not settings.reducedMotion
  elseif key == "s" then settings.subtitles = not settings.subtitles
  elseif key == "v" then settings.voiceMuted = not settings.voiceMuted
  elseif key == "p" then settings.paused = not settings.paused
  elseif key == "l" then host.locale()
  elseif key == "q" then host.enqueue("conversation")
  elseif key == "n" then host.enqueue("radio")
  elseif key == "f5" then host.save()
  elseif key == "f9" then host.restore()
  elseif key == "r" then host.reset()
  elseif key == "escape" then
    if settings.help or settings.transcript then
      settings.help = false
      settings.transcript = false
    else love.event.quit() end
  end
  host.update(0)
end
function love.draw()
  local width, height = love.graphics.getDimensions()
  local settings = host.settings
  local theme = Theme.palette(settings.mode)
  love.graphics.clear(theme.stage)
  love.graphics.setColor(0.72, 0.77, 0.75)
  love.graphics.setFont(caption)
  love.graphics.print("BEACON HARBOR  /  A DIALOGUE STUDY", 32, 24)
  love.graphics.setFont(title)
  love.graphics.setColor(0.94, 0.92, 0.85)
  love.graphics.print(
    settings.entry == "staging" and "Across the water" or (settings.entry == "start" and "The last light" or (settings.entry == "rich" and "Words with character" or "A short introduction")),
    32,
    47
  )
  love.graphics.setFont(caption)
  local style = Styles.name(settings.mode)
  love.graphics.setColor(0.72, 0.77, 0.75)
  love.graphics.printf(
    style
    .. (settings.entry == "staging" and "  /  Character staging · F4 to return" or "  /  Portrait: " .. settings.portrait),
    32,
    91,
    width - 64,
    "left"
  )
  love.graphics.printf(
    settings.entry == "staging" and "1–7  Style     F4  Return     H  Controls" or "1–7  Style     O  Portrait     H  Controls",
    32,
    height - 33,
    width - 64,
    "left"
  )
  if settings.notice ~= "" then
    love.graphics.printf(settings.notice, 32, height - 59, width - 64, "left")
  end
  local snapshot = host.player():snapshot()
  local radio = host.radio:snapshot()
  local showRadio = radio.state == "awaiting_advance" and not host.modal()
  local node = snapshot.node
  if node and (snapshot.state == "awaiting_advance" or snapshot.state == "awaiting_choice") then
    local appliedScroll = 0
    if settings.entry == "staging" then
      local layout = Staging.resolve(node.speakerKey, node.textId)
      local box = Staging.geometry(layout, width, height, snapshot.state == "awaiting_choice")
      local mara = node.speakerKey == "cast.mara.name"
      local ivo = node.speakerKey == "cast.ivo.name"
      presenter.portrait(
        mara and (node.portrait or "mara") or "mara",
        32,
        box.portraitY,
        box.portraitSize,
        mara
      )
      presenter.portrait(
        ivo and (node.portrait or "ivo") or "ivo",
        width - 32 - box.portraitSize,
        box.portraitY,
        box.portraitSize,
        ivo
      )
      love.graphics.setFont(caption)
      love.graphics.setColor(0.82, 0.86, 0.82)
      love.graphics.print("Mara · west pier", 32, box.portraitY + box.portraitSize + 8)
      love.graphics.printf(
        "Ivo · east pier",
        32,
        box.portraitY + box.portraitSize + 8,
        width - 64,
        "right"
      )
      maxScroll, appliedScroll = presenter.draw(node, host.clusters(), host.view().visible, settings.mode,
        settings.reducedMotion, settings.subtitles, settings.selected, settings.scroll, "none", false, box)
    else
      maxScroll, appliedScroll = presenter.draw(node, host.clusters(), host.view().visible, settings.mode,
        settings.reducedMotion, settings.subtitles, settings.selected, settings.scroll, settings.portrait, showRadio)
    end
    settings.scroll = appliedScroll or math.min(settings.scroll, maxScroll)
  end
  local radioNode = radio.node
  if radioNode
    and showRadio then
    presenter.draw(radioNode, host.radioClusters(), host.radioView().visible, "announcement",
      settings.reducedMotion, settings.subtitles, 0, 0)
  end
  if snapshot.state == "completed" then
    love.graphics.setFont(title)
    love.graphics.setColor(theme.text)
    love.graphics.printf("The crossing ends here.", 32, height * 0.46, width - 64, "center")
    love.graphics.setFont(caption)
    love.graphics.setColor(theme.muted)
    love.graphics.printf(
      "R  Read again     TAB  Recent conversation",
      32,
      height * 0.46 + 49,
      width - 64,
      "center"
    )
  elseif snapshot.state == "waiting" then
    love.graphics.setFont(caption)
    love.graphics.setColor(theme.muted)
    love.graphics.printf("Listening to the channel…", 32, height * 0.5, width - 64, "center")
  end
  if settings.help then
    love.graphics.setColor(0.075, 0.105, 0.12, 0.98)
    love.graphics.rectangle("fill", 24, 115, width - 48, height - 170, 3, 3)
    love.graphics.setColor(0.94, 0.92, 0.85)
    love.graphics.setFont(caption)
    local stats = host.metrics()
    local facts = host.player():getContext()
    love.graphics.printf(
      "CONTROLS & FEATURES  ·  H to close\n\n1–4   Original styles     5 Mythic / 6 Tactics / 7 Terminal\nO   Portrait left / right / above / hidden\nSpace / Enter   Reveal, continue or confirm     ↑ ↓   Choose\n[ / ]   Scroll     Tab   Recent conversation\nF   Reveal speed   "
      .. settings.speed .. "x     M   Reduced motion   " .. tostring(settings.reducedMotion) ..
      "\nS   Subtitles   " .. tostring(settings.subtitles) .. "     V   Mute voice   "
      .. tostring(settings.voiceMuted) ..
      "\nL   Language   " .. settings.locale .. "     G   Harbor permit   "
      .. tostring(facts.permit) ..
      "\nP   Pause   " .. tostring(settings.paused)
      .. "     R   Restart\nF5 / F9   Save / restore checkpoint     F2   Story / short demo   F3   Rich text   F4   Staging\nQ / N   Queue conversation / radio     Esc   Quit\n\nWaiting: "
      .. stats.conversations .. "/2 talks · " .. stats.messages .. "/4 messages · "
      .. stats.rejected .. " rejected\nEvents: " .. stats.shown .. " shown · " .. stats.revealed
      .. " revealed · Tokens: " .. stats.rewards,
      44, 135, width - 88)
  end
  if settings.transcript and not settings.help then
    maxHistoryScroll, settings.historyScroll = transcript.draw(
      host.player():history().entries,
      settings.historyScroll
    )
  end
end
function love.mousepressed(x: number, y: number, button: number)
  if button ~= 1 or not host.settings.transcript or host.settings.help then return end
  local direction = transcript.click(x, y)
  host.settings.historyScroll = math.max(0, math.min(maxHistoryScroll,
    host.settings.historyScroll + direction * 58))
end
function love.quit()
  host.dispose()
  presenter.dispose()
  transcript.dispose()
  title:release()
  caption:release()
end
return host
