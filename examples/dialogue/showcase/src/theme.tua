export type Color = number[]
export type Palette = {
  stage: Color, panel: Color, text: Color, muted: Color, accent: Color, focus: Color,
}
local cinema: Palette = {
  stage = { 0.075, 0.105, 0.12 },
  panel = { 0.12, 0.16, 0.18 },
  text = { 0.94, 0.92, 0.85 },
  muted = { 0.64, 0.70, 0.70 },
  accent = { 0.83, 0.69, 0.44 },
  focus = { 0.22, 0.29, 0.31 },
}
local paper: Palette = {
  stage = { 0.22, 0.29, 0.28 },
  panel = { 0.88, 0.87, 0.77 },
  text = { 0.15, 0.23, 0.23 },
  muted = { 0.33, 0.41, 0.38 },
  accent = { 0.39, 0.24, 0.19 },
  focus = { 0.77, 0.80, 0.70 },
}
local radio: Palette = {
  stage = { 0.075, 0.105, 0.12 },
  panel = { 0.12, 0.20, 0.21 },
  text = { 0.85, 0.94, 0.89 },
  muted = { 0.61, 0.75, 0.69 },
  accent = { 0.54, 0.85, 0.72 },
  focus = { 0.20, 0.34, 0.32 },
}
local mythic: Palette = {
  stage = { 0.075, 0.105, 0.12 },
  panel = { 0.92, 0.91, 0.83 },
  text = { 0.15, 0.19, 0.19 },
  muted = { 0.35, 0.38, 0.34 },
  accent = { 0.42, 0.29, 0.14 },
  focus = { 0.81, 0.79, 0.67 },
}
local tactics: Palette = {
  stage = { 0.22, 0.29, 0.28 },
  panel = { 0.97, 0.95, 0.86 },
  text = { 0.18, 0.17, 0.24 },
  muted = { 0.39, 0.35, 0.35 },
  accent = { 0.59, 0.17, 0.29 },
  focus = { 0.88, 0.83, 0.71 },
}
local terminal: Palette = {
  stage = { 0.075, 0.105, 0.12 },
  panel = { 0.075, 0.16, 0.17 },
  text = { 0.81, 0.87, 0.72 },
  muted = { 0.61, 0.70, 0.56 },
  accent = { 0.76, 0.85, 0.48 },
  focus = { 0.23, 0.33, 0.28 },
}
local function palette(mode: string): Palette
  if mode == "mythic" then return mythic end
  if mode == "tactics" then return tactics end
  if mode == "terminal" then return terminal end
  if mode == "bubble" then return paper end
  if mode == "radio" or mode == "announcement" then return radio end
  return cinema
end
return { palette = palette }
