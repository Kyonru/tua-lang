  ["crossing.hub.choice.2"] = "Pourquoi le phare est-il éteint ?",
  ["crossing.hub.choice.3"] = "Montrez-moi la carte du chenal.",
  ["crossing.hub.choice.4"] = "Il faut prendre une décision.",
