local scene = require("scene")
local first = Dialogue.new(scene)
local second = Dialogue.new(scene)
first:start()
second:start("talking")
local firstNode = first:snapshot().node
local secondNode = second:snapshot().node
assert(firstNode and firstNode.expression == "happy")
assert(secondNode and secondNode.portraitAnimation == "talk")
assert(first:advance())
firstNode = first:snapshot().node
assert(firstNode and firstNode.expression == nil)
assert(firstNode and firstNode.portrait == "portraits/guide.png")
assert(first:advance())
firstNode = first:snapshot().node
assert(firstNode and firstNode.portrait == nil)
second:start("worried")
secondNode = second:snapshot().node
assert(secondNode and secondNode.speaker == "Captain")
assert(secondNode and secondNode.expression == "worried")
first:dispose()
second:dispose()
print("character expressions passed")

-- Descriptors stay renderer/audio neutral; the host resolves actual samples.
local media = require("media")
local voiced = Dialogue.new(media, { locale = "fr" })
voiced:start()
local node = voiced:snapshot().node
assert(node ~= nil)
local voice = node.voice
assert(voice ~= nil)
assert(voice.locale == "fr" and voice.sourceLocale == "en")
assert(voice.fallback == "silent" and not voice.mixSpeech)
voiced:setLocale("en")
assert(voiced:advance())
node = voiced:snapshot().node
assert(node ~= nil and node.speech == "off")
assert(voiced:advance())
assert(voiced:advance())
node = voiced:snapshot().node
assert(node ~= nil and node.speech == nil and node.voice == nil)
voiced:dispose()
print("voice and speech descriptors passed")
