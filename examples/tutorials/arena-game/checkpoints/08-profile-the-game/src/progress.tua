local Profile = require("profile")
local function new()
  local profile = Profile.new()
  local saved, loadIssue = profile:load()
  local game = store(saved or profile:defaults())
  -- Schema numbers are finite; gameplay constraints are a separate validation step.
  local data = game:get()
  local invalid = data.clearedWave < 0
    or data.clearedWave % 1 ~= 0
    or data.health < 1
    or data.health > 10
    or data.health % 1 ~= 0
    or data.music < 0
    or data.music > 1
    or data.effects < 0
    or data.effects > 1
  local ui = { status = "new", confirmReset = false, resetFailed = false }
  if loadIssue or invalid then
    ui.status = "blocked"
  elseif saved then
    ui.status = "loaded"
  end
  local function blocked(): boolean
    return loadIssue ~= nil or invalid
  end
  local function bind()
    return profile:bind(game, {
      select = function(state)
        return state
      end,
      debounce = 1,
      max_interval = 10,
    })
  end
  local binding = bind()
  local disposed = false
  local function save(): boolean
    if disposed or blocked() or ui.confirmReset then
      return false
    end
    local ok = binding:flush()
    ui.status = ok and "saved" or "failed"
    return ok
  end
  local function preferences(options: Profile.Preferences)
    if disposed or blocked() or ui.confirmReset then
      return
    end
    local current = game:get()
    if
      current.locale == options.locale
      and current.music == options.music
      and current.effects == options.effects
      and current.muted == options.muted
      and current.feedback == options.feedback
      and current.reducedMotion == options.reducedMotion
      and current.shader == options.shader
    then
      return
    end
    game:update(function(state)
      state.locale = options.locale
      state.music = options.music
      state.effects = options.effects
      state.muted = options.muted
      state.feedback = options.feedback
      state.reducedMotion = options.reducedMotion
      state.shader = options.shader
    end)
    ui.status = "pending"
  end
  -- The host must establish the empty-world boundary before calling this.
  local function checkpoint(wave: number, health: number): boolean
    if
      disposed
      or blocked()
      or ui.confirmReset
      or wave < 1
      or wave % 1 ~= 0
      or health < 1
      or health > 10
      or health % 1 ~= 0
    then
      return false
    end
    game:update(function(state)
      state.clearedWave = wave
      state.health = health
    end)
    return save()
  end
  local function update(dt: number)
    if disposed or blocked() or ui.confirmReset then
      return
    end
    local wrote = binding:update(dt)
    if binding:lastIssue() then
      ui.status = "failed"
    elseif wrote then
      ui.status = "saved"
    end
  end
  local function recover(): boolean
    if disposed or invalid or ui.confirmReset or not loadIssue then
      return false
    end
    if loadIssue.code ~= "damaged_slot_unverified" or not profile:acceptRecovery() then
      return false
    end
    loadIssue = nil
    binding:markDirty()
    ui.status = "pending"
    return true
  end
  local function requestReset()
    if not disposed then
      ui.confirmReset = true
      ui.resetFailed = false
    end
  end
  local function cancelReset()
    ui.confirmReset = false
  end
  local function confirmReset(): boolean
    if disposed or not ui.confirmReset then
      return false
    end
    local defaults, issue = profile:reset()
    if not defaults then
      loadIssue = issue or loadIssue
      ui.status = "blocked"
      ui.resetFailed = true
      return false
    end
    binding:dispose()
    game:set(defaults)
    binding = bind()
    loadIssue = nil
    invalid = false
    ui.confirmReset = false
    ui.status = "new"
    return true
  end
  local function dispose(): boolean
    if disposed then
      return true
    end
    local ok = save()
    binding:dispose()
    disposed = true
    return ok
  end
  return {
    snapshot = function()
      return game:get()
    end,
    issue = function()
      return loadIssue
    end,
    blocked = blocked,
    ui = ui,
    preferences = preferences,
    checkpoint = checkpoint,
    save = save,
    update = update,
    recover = recover,
    requestReset = requestReset,
    cancelReset = cancelReset,
    confirmReset = confirmReset,
    dispose = dispose,
  }
end
return { new = new }
