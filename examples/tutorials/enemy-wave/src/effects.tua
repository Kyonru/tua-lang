-- Optional cosmetic storage: no entity IDs or component references are retained.
export type Ring = { x: number, y: number, age: number }
local function new()
  local pool = objectPool({
    create = function(): Ring return { x = 0, y = 0, age = 0 } end,
    reset = function(ring: Ring)
      ring.x = 0
      ring.y = 0
      ring.age = 0
    end,
  })
  local items: Ring[] = {}
  local disposed = false
  local function spawn(x: number, y: number): boolean
    if disposed or #items >= 16 then return false end
    local ring = pool:acquire()
    ring.x = x
    ring.y = y
    items[#items + 1] = ring
    return true
  end
  local function update(dt: number)
    for index = #items, 1, -1 do
      local ring = items[index]
      ring.age += dt
      if ring.age >= 0.4 then
        table.remove(items, index)
        pool:release(ring)
      end
    end
  end
  local function clear()
    for index = #items, 1, -1 do
      local ring = items[index]
      table.remove(items, index)
      pool:release(ring)
    end
  end
  local function dispose()
    if disposed then return end
    clear()
    pool:clear()
    disposed = true
  end
  return {
    items = items,
    spawn = spawn,
    update = update,
    clear = clear,
    dispose = dispose,
    activeCount = function() return pool:activeCount() end,
    capacity = function() return pool:capacity() end,
  }
end
return { new = new }
