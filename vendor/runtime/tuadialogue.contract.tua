-- Compiler-visible declaration; runtime implementation lives in tuadialogue.lua.
type Instruction = {
  op: "value" | "nil" | "path" | "not" | "and" | "or" | "==" | "!=" | "~=" | "<" | "<=" | ">" | ">=",
  value?: string | number | boolean,
  path?: string,
}
type Condition = Instruction[]
type Option = {
  id: string,
  text: string,
  target: string,
  visible?: Condition,
  enabled?: Condition,
  reason?: string,
  reasonId?: string,
}
type ChoiceView = {
  id: string,
  text: string,
  target: string,
  enabled?: boolean,
  reason?: string,
  reasonId?: string,
}
type EventSource = { line: number, column: number }
type Event = {
  kind?: nil,
  id?: string,
  source?: EventSource,
  anchor: "shown" | "revealed",
  delay: number,
  name: string,
  payload: string,
}
type FiredEvent = {
  kind?: nil,
  eventId?: string,
  documentId?: string,
  source?: EventSource,
  name: string,
  payload: string,
  generation: number,
  visit: number,
  nodeId: string,
}
type ActionEffect = "presentation" | "consequential"
type ActionRequest = {
  actionId: string,
  name: string,
  effect: ActionEffect,
  documentId: string,
  nodeId: string,
  generation: number,
  visit: number,
  source?: EventSource,
}
type ActionNode = {
  kind: "action",
  name: string,
  id: string,
  payload: { [string]: any },
  success: string,
  failure: string,
  source?: EventSource,
}
type Node = {
  kind: "line",
  text: string,
  textId?: string,
  speakerKey?: string,
  speaker?: string,
  portrait?: string,
  next: string,
  hold?: number,
  fade?: number,
  events?: Event[],
}
  | { kind: "choice", options: Option[], fallback?: string }
  | { kind: "branch", condition: Condition, yes: string, no: string }
  | { kind: "end" }
  | ActionNode
type Binding = { name: string, path: string, fallback?: string | number | boolean }
type Document = {
  actions?: { kind: "actions" },
  events?: { kind: "events" },
  context?: { kind: "context" },
  bindings?: Binding[],
  schemaVersion?: number,
  documentId?: string,
  entry: string,
  nodes: { [string]: Node },
}
type Arguments = { [string]: string | number | boolean }
type Resolver = (key: string, source: string, args: Arguments, locale: string) -> string
type Options = {
  transitionBudget?: number,
  locale?: string,
  args?: Arguments,
  resolve?: Resolver,
}
type PresentationNode = {
  kind: "line" | "choice" | "end",
  text: string,
  textId?: string,
  speakerKey?: string,
  speaker?: string,
  portrait?: string,
  hold?: number,
  fade?: number,
  events?: Event[],
  next?: string,
  options: ChoiceView[],
}
type ActionIssue = {
  code: "transition_budget_exceeded" | "action_handler_missing" | "action_handler_error" | "action_result_invalid" | "action_transition_error",
  message: string,
  nodeId: string,
  actionId?: string,
  name?: string,
  effect?: ActionEffect,
  documentId?: string,
  source?: EventSource,
  generation?: number,
  visit?: number,
}
type Snapshot = {
  action?: ActionRequest,
  issue?: ActionIssue,
  locale?: string,
  documentId?: string,
  presentationRevision: number,
  revealComplete: boolean,
  state: "idle" | "awaiting_advance" | "awaiting_choice" | "completed" | "cancelled" | "disposed" | "faulted" | "awaiting_action",
  generation: number,
  visit: number,
  nodeId?: string,
  node?: PresentationNode,
}
local function start(self: any, entry?: string): nil
  error("declaration only")
end
local function new(source: Document, options?: Options): {
  runAction: (self: any) -> boolean,
  setLocale: (self: any, locale: string) -> boolean,
  update: (self: any, dt: number, revealed: boolean) -> FiredEvent[],
  advance: (self: any) -> boolean,
  choose: (self: any, id: string) -> boolean,
  cancel: (self: any) -> boolean,
  snapshot: (self: any) -> Snapshot,
  dispose: (self: any) -> nil,
}
error("declaration only")
end
return { new = new }
