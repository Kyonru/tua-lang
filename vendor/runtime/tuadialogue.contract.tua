-- Compiler-visible declaration; runtime implementation lives in tuadialogue.lua.
type Option = { id: string, text: string, target: string }
type Event = { anchor: "shown" | "revealed", delay: number, name: string, payload: string }
type FiredEvent = {
  name: string,
  payload: string,
  generation: number,
  visit: number,
  nodeId: string,
}
type Node = {
  kind: "line",
  text: string,
  textId?: string,
  speakerKey?: string,
  speaker?: string,
  portrait?: string,
  next: string,
  hold?: number,
  fade?: number,
  events?: Event[],
}
  | { kind: "choice", options: Option[] }
  | { kind: "end" }
type Binding = { name: string, path: string, fallback?: string | number | boolean }
type Document = {
  context?: { kind: "context" },
  bindings?: Binding[],
  schemaVersion?: number,
  documentId?: string,
  entry: string,
  nodes: { [string]: Node },
}
type Arguments = { [string]: string | number | boolean }
type Options = {
  locale: string,
  args?: Arguments,
  resolve: (key: string, source: string, args: Arguments, locale: string) -> string,
}
type PresentationNode = {
  kind: "line" | "choice" | "end",
  text: string,
  textId?: string,
  speakerKey?: string,
  speaker?: string,
  portrait?: string,
  hold?: number,
  fade?: number,
  events?: Event[],
  next?: string,
  options: Option[],
}
type Snapshot = {
  locale?: string,
  documentId?: string,
  presentationRevision: number,
  revealComplete: boolean,
  state: "idle" | "awaiting_advance" | "awaiting_choice" | "completed" | "cancelled" | "disposed",
  generation: number,
  visit: number,
  nodeId?: string,
  node?: PresentationNode,
}
local function start(self: any, entry?: string): nil
  error("declaration only")
end
local function new(source: Document, options?: Options): {
  setLocale: (self: any, locale: string) -> boolean,
  update: (self: any, dt: number, revealed: boolean) -> FiredEvent[],
  advance: (self: any) -> boolean,
  choose: (self: any, id: string) -> boolean,
  cancel: (self: any) -> boolean,
  snapshot: (self: any) -> Snapshot,
  dispose: (self: any) -> nil,
}
error("declaration only")
end
return { new = new }
