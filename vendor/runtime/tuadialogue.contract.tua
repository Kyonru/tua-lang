type RichRun = {
  firstCluster: number,
  lastCluster: number,
  emphasis: boolean,
  styles: string[],
  rate?: number,
  pronunciation?: string,
}
type RichOrigin = {
  startByte: number,
  endByte: number,
  templateStartByte: number,
  templateEndByte: number,
  argument?: string,
}
type RichPresentation = {
  text: string,
  runs: RichRun[],
  pauses: { afterCluster: number, seconds: number }[],
  origins: RichOrigin[],
  resolvedLocale?: string,
  variant?: string,
}
-- Compiler-visible declaration; runtime implementation lives in tuadialogue.lua.
type Instruction = {
  op: "value" | "nil" | "path" | "not" | "and" | "or" | "==" | "!=" | "~=" | "<" | "<=" | ">" | ">=",
  value?: string | number | boolean,
  path?: string,
}
type Condition = Instruction[]
type Option = {
  richText?: string,
  richReason?: string,
  id: string,
  text: string,
  target: string,
  visible?: Condition,
  enabled?: Condition,
  reason?: string,
  reasonId?: string,
}
type ChoiceView = {
  presentation?: RichPresentation,
  reasonPresentation?: RichPresentation,
  id: string,
  text: string,
  target: string,
  enabled?: boolean,
  reason?: string,
  reasonId?: string,
}
type EventSource = { line: number, column: number }
type Event = {
  kind?: nil,
  id?: string,
  source?: EventSource,
  anchor: "shown" | "revealed",
  delay: number,
  name: string,
  payload: string,
}
type FiredEvent = {
  kind?: nil,
  eventId?: string,
  documentId?: string,
  source?: EventSource,
  name: string,
  payload: string,
  generation: number,
  visit: number,
  nodeId: string,
}
type ActionEffect = "presentation" | "consequential"
type ActionHandleStatus = "pending" | "resolved" | "rejected" | "cancelled"
type ActionHandle = {
  resolve: (self: any, result: boolean) -> boolean,
  reject: (self: any, message: string) -> boolean,
  cancel: (self: any) -> boolean,
  snapshot: (self: any) -> { status: ActionHandleStatus, cancellationError?: string },
}
type ActionHandleOptions = { cancel?: () -> nil }
local function actionHandle(options?: ActionHandleOptions): ActionHandle
  error("declaration only")
end
type ActionRequest = {
  status: "ready" | ActionHandleStatus,
  actionId: string,
  name: string,
  effect: ActionEffect,
  documentId: string,
  nodeId: string,
  generation: number,
  visit: number,
  source?: EventSource,
}
type ActionNode = {
  kind: "action",
  name: string,
  id: string,
  payload: { [string]: any },
  success: string,
  failure: string,
  source?: EventSource,
}
type Expression = { portrait: string, animation?: string }
type Node = {
  richText?: string,
  kind: "line",
  text: string,
  textId?: string,
  speakerKey?: string,
  speaker?: string,
  portrait?: string,
  expression?: string,
  expressions?: { [string]: Expression },
  next: string,
  hold?: number,
  fade?: number,
  events?: Event[],
}
  | { kind: "choice", options: Option[], fallback?: string }
  | { kind: "branch", condition: Condition, yes: string, no: string }
  | { kind: "end" }
  | { kind: "wait", duration: number, next: string, source?: EventSource }
  | ActionNode
type Binding = { name: string, path: string, fallback?: string | number | boolean }
type Document = {
  actions?: { kind: "actions" },
  events?: { kind: "events" },
  context?: { kind: "context" },
  bindings?: Binding[],
  schemaVersion?: number,
  documentId?: string,
  entry: string,
  nodes: { [string]: Node },
}
type Arguments = { [string]: string | number | boolean }
type Resolver = (key: string, source: string, args: Arguments, locale: string) -> string
type TemplateResult = { template: string, locale?: string, variant?: string }
type TemplateResolver = (
  key: string,
  source: string,
  args: Arguments,
  locale: string
) -> TemplateResult
type Options = {
  transitionBudget?: number,
  locale?: string,
  args?: Arguments,
  resolve?: Resolver,
  resolveTemplate?: TemplateResolver,
}
type PresentationNode = {
  presentation?: RichPresentation,
  kind: "line" | "choice" | "end",
  text: string,
  textId?: string,
  speakerKey?: string,
  speaker?: string,
  portrait?: string,
  expression?: string,
  portraitAnimation?: string,
  hold?: number,
  fade?: number,
  events?: Event[],
  next?: string,
  options: ChoiceView[],
}
type ActionIssue = {
  code: "transition_budget_exceeded" | "action_handler_missing" | "action_handler_error" | "action_result_invalid" | "action_transition_error" | "action_rejected" | "action_cancelled" | "wait_transition_error",
  message: string,
  nodeId: string,
  actionId?: string,
  name?: string,
  effect?: ActionEffect,
  documentId?: string,
  source?: EventSource,
  generation?: number,
  visit?: number,
}
type WaitView = {
  duration: number,
  elapsed: number,
  remaining: number,
  source?: EventSource,
}
type Snapshot = {
  suspended: boolean,
  wait?: WaitView,
  action?: ActionRequest,
  issue?: ActionIssue,
  locale?: string,
  documentId?: string,
  presentationRevision: number,
  revealComplete: boolean,
  state: "idle" | "awaiting_advance" | "awaiting_choice" | "completed" | "cancelled" | "disposed" | "faulted" | "awaiting_action" | "waiting",
  generation: number,
  visit: number,
  nodeId?: string,
  node?: PresentationNode,
}
-- The adapter consumes presentation fields only; event payloads stay generic.
type RevealNode = { kind: string, text: string, presentation?: RichPresentation }
type RevealInput = {
  suspended?: boolean,
  generation: number,
  visit: number,
  presentationRevision: number,
  revealComplete: boolean,
  state: "idle" | "awaiting_advance" | "awaiting_choice" | "completed" | "cancelled" | "disposed" | "faulted" | "awaiting_action" | "waiting",
  node?: RevealNode,
}
type RevealOptions = {
  rate?: number,
  speech?: boolean,
  minCueInterval?: number,
  reducedMotion?: boolean,
}
type Grapheme = {
  index: number,
  text: string,
  startByte: number,
  endByte: number,
  speakable: boolean,
}
type SpeechCue = {
  instance: number,
  sequence: number,
  generation: number,
  visit: number,
  presentationRevision: number,
  index: number,
  text: string,
  startByte: number,
  endByte: number,
}
type RevealView = {
  text: string,
  visible: number,
  total: number,
  complete: boolean,
  instance: number,
  sequence: number,
  generation?: number,
  visit?: number,
  presentationRevision?: number,
  cues: SpeechCue[],
}
local function reveal(options?: RevealOptions): {
  present: (self: any, snapshot: RevealInput) -> boolean,
  update: (self: any, dt: number) -> RevealView,
  finish: (self: any) -> RevealView,
  clear: (self: any) -> nil,
  snapshot: (self: any) -> RevealView,
  clusters: (self: any) -> Grapheme[],
}
error("declaration only")
end
local function start(self: any, entry?: string): nil
  error("declaration only")
end
local function new(source: Document, options?: Options): {
  suspend: (self: any) -> boolean,
  resume: (self: any) -> boolean,
  runAction: (self: any) -> boolean,
  setLocale: (self: any, locale: string) -> boolean,
  update: (self: any, dt: number, revealed: boolean) -> FiredEvent[],
  advance: (self: any) -> boolean,
  choose: (self: any, id: string) -> boolean,
  cancel: (self: any) -> boolean,
  snapshot: (self: any) -> Snapshot,
  dispose: (self: any) -> nil,
}
error("declaration only")
end
return { new = new }
