{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (All Examples)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "--log",
        "SolenodonteLabs.tua:debug",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "Build Extension and Server",
      "skipFiles": ["<node_internals>/**/*.js"],
      "env": {
        "TUA_SERVER_PATH": "${workspaceFolder}/target/debug/tua",
        "TUA_DEBUG_LSP": "1"
      },
      "windows": {
        "env": {
          "TUA_SERVER_PATH": "${workspaceFolder}/target/debug/tua.exe",
          "TUA_DEBUG_LSP": "1"
        }
      }
    },
    {
      "name": "Run Extension (Features Example)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "--log",
        "SolenodonteLabs.tua:debug",
        "${workspaceFolder}/examples/features"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "Build Extension and Server",
      "skipFiles": ["<node_internals>/**/*.js"],
      "env": {
        "TUA_SERVER_PATH": "${workspaceFolder}/target/debug/tua"
      },
      "windows": {
        "env": {
          "TUA_SERVER_PATH": "${workspaceFolder}/target/debug/tua.exe"
        }
      }
    },
    {
      "name": "Run Extension (Features Example, Bundled Server)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "--log",
        "SolenodonteLabs.tua:debug",
        "${workspaceFolder}/examples/features"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "Build Extension and Stage Server",
      "skipFiles": ["<node_internals>/**/*.js"]
    },
    {
      "name": "Run Extension (Debug Server)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "--log",
        "SolenodonteLabs.tua:debug",
        "${workspaceFolder}/examples/love-full"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "Build Extension and Server",
      "skipFiles": ["<node_internals>/**/*.js"],
      "env": {
        "TUA_SERVER_PATH": "${workspaceFolder}/target/debug/tua"
      },
      "windows": {
        "env": {
          "TUA_SERVER_PATH": "${workspaceFolder}/target/debug/tua.exe"
        }
      }
    },
    {
      "name": "Run Extension (Release Server)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "--log",
        "SolenodonteLabs.tua:debug",
        "${workspaceFolder}/examples/love-full"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "Build Extension and Release Server",
      "skipFiles": ["<node_internals>/**/*.js"],
      "env": {
        "TUA_SERVER_PATH": "${workspaceFolder}/target/release/tua"
      },
      "windows": {
        "env": {
          "TUA_SERVER_PATH": "${workspaceFolder}/target/release/tua.exe"
        }
      }
    },
    {
      "name": "Run Extension (Bundled Server)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "--log",
        "SolenodonteLabs.tua:debug",
        "${workspaceFolder}/examples/love-full"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "Build Extension and Stage Server",
      "skipFiles": ["<node_internals>/**/*.js"]
    },
    {
      "name": "Run With Extensions (Release Server)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extension",
        "SolenodonteLabs.tua",
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "--log",
        "SolenodonteLabs.tua:debug",
        "${workspaceFolder}/examples/love-full"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "Build Extension and Release Server",
      "skipFiles": ["<node_internals>/**/*.js"],
      "env": {
        "TUA_SERVER_PATH": "${workspaceFolder}/target/release/tua"
      },
      "windows": {
        "env": {
          "TUA_SERVER_PATH": "${workspaceFolder}/target/release/tua.exe"
        }
      }
    },
    {
      "name": "Attach To Server",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}/target/debug/tua",
      "pid": "${command:pickMyProcess}",
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Win Attach To Server",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
