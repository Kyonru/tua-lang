{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check Extension",
      "group": "build",
      "type": "npm",
      "script": "check",
      "path": "editors/vscode/",
      "problemMatcher": []
    },
    {
      "label": "Build Extension (Debug)",
      "group": "build",
      "type": "npm",
      "script": "build:dev",
      "path": "editors/vscode/",
      "problemMatcher": []
    },
    {
      "label": "Package Extension",
      "group": "build",
      "type": "shell",
      "command": "make extension-package",
      "problemMatcher": []
    },
    {
      "label": "Stage Extension Server",
      "group": "build",
      "type": "npm",
      "script": "stage:server",
      "path": "editors/vscode/",
      "dependsOn": "Build Server (Release)",
      "problemMatcher": []
    },
    {
      "label": "Clean Extension Server",
      "type": "npm",
      "script": "clean:server",
      "path": "editors/vscode/",
      "problemMatcher": []
    },
    {
      "label": "Build Server",
      "group": "build",
      "type": "shell",
      "command": "cargo build --package tua-cli",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build Server (Release)",
      "group": "build",
      "type": "shell",
      "command": "cargo build --release --package tua-cli",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Run Tests",
      "group": "test",
      "type": "shell",
      "command": "cargo test --workspace",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Run Clippy",
      "group": "test",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build Examples",
      "group": "build",
      "type": "shell",
      "command": "make build-examples",
      "problemMatcher": []
    },
    {
      "label": "Verify Workspace",
      "group": "test",
      "type": "shell",
      "command": "make verify",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build Extension and Server",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Extension (Debug)",
        "Build Server"
      ],
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build Extension and Release Server",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Extension (Debug)",
        "Build Server (Release)"
      ],
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build Extension and Stage Server",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Extension (Debug)",
        "Stage Extension Server"
      ],
      "problemMatcher": "$rustc"
    }
  ]
}
