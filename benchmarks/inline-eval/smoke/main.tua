-- Inline-completion smoke fixture. Results are pinned in expected.json;
-- regenerate it with `make inline-eval-smoke-update` after intended changes.

local bullets = {}

local function spawnBullet(x: number, y: number)
  table.insert(bullets, { x = x, y = y, speed = 300 })
end

function love.load()
  love.graphics.setBackgroundColor(0, 0, 0)
end

function love.update(dt: number)
  for index = #bullets, 1, -1 do
    local bullet = bullets[index]
    bullet.y = bullet.y - bullet.speed * dt
    if bullet.y < 0 then
      table.remove(bullets, index)
    end
  end
  if love.keyboard.isDown("space") then
    spawnBullet(400, 500)
  end
end

function love.draw()
  love.graphics.setColor(1, 1, 1, 1)
  for _, bullet in ipairs(bullets) do
    love.graphics.circle("fill", bullet.x, bullet.y, 3)
  end
  love.graphics.setColor(1, 1, 1, 1)
  love.graphics.print("bullets " .. #bullets, 10, 10)
end
