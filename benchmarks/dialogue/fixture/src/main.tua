local document = require("scene")
local legacy = require("legacy")
local contracts = require("forward")
local facts = contracts.view()
assert(facts.player.name == "Ada" and facts.player.coins == 20)
local reward = 0
contracts.events:on("reward", function(payload: { coins: number }) reward += payload.coins end)
contracts.events:emit("reward", { coins = 2 })
assert(reward == 2)

local first = Dialogue.new(document)
local second = Dialogue.new(document)
first:start()
second:start("finish")
local node = first:snapshot().node
assert(node and node.speaker == "Guide" and node.portrait == "guide.png")
assert(#first:update(0.2, false) == 1)
assert(#second:update(100, true) == 0)
first:update(0, true)
assert(#first:update(0.25, true) == 1)
assert(first:advance())
assert(not first:choose("unknown"))
assert(first:choose("baseline.again"))
assert(#first:update(0.2, false) == 1)
assert(first:advance())
assert(first:choose("baseline.leave"))
assert(first:advance())
assert(first:snapshot().state == "completed")
assert(second:snapshot().state == "awaiting_advance")
first:dispose()
second:dispose()

local old = Dialogue.new(legacy)
old:start()
assert(old:advance())
assert(old:advance())
assert(old:snapshot().state == "completed")
old:dispose()
print("dialogue-v1 compatibility passed")
