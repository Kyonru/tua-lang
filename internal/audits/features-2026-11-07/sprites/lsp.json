{
  "source": "local Sheet = spriteSheet({\n  image = \"assets/player.png\",\n  frame = { width = 32, height = 32 },\n  origin = { x = 16, y = 32 },\n  animations = {\n    run = { from = 0, to = 3, fps = 4, markers = { { frame = 0, name = \"start\" }, { frame = 1, name = \"step\" } } },\n    stopStart = { from = 0, to = 3, fps = 4, onLoop = \"pauseAtStart\" },\n    stopEnd = { from = 0, to = 3, fps = 4, onLoop = \"pauseAtEnd\" },\n    loopFn = { from = 0, to = 3, fps = 4, onLoop = function(animation, loops)\n      print(\"LOOP_CALLBACK\", loops)\n      if loops > 1 then animation:pause() end\n    end },\n    single = { column = 0, fps = 1 },\n    multi = { frames = { { from = 0, to = 1, row = 0 }, { column = 1, row = 1 } }, durations = { 0.1, 0.2, 0.3 } },\n  },\n})\nlocal Parent = spriteSheet({\n  image = \"assets/player.png\",\n  frame = { width = 32, height = 32 },\n  animations = { idle = { column = 0, fps = 1 } },\n  children = { hat = { sheet = Sheet, initial = \"run\", x = 4, y = -8 } },\n})\nlocal player = Sheet:player(\"run\")\nplayer:play(\"absent\")\nplayer:play(\"run\")\nplayer:on(\"step\", function() end)\n",
