local Sheet = spriteSheet({
  image = "assets/player.png",
  frame = { width = 32, height = 32 },
  origin = { x = 16, y = 32 },
  animations = {
    run = { from = 0, to = 3, fps = 4, markers = { { frame = 0, name = "start" }, { frame = 1, name = "step" } } },
    stopStart = { from = 0, to = 3, fps = 4, onLoop = "pauseAtStart" },
    stopEnd = { from = 0, to = 3, fps = 4, onLoop = "pauseAtEnd" },
    loopFn = { from = 0, to = 3, fps = 4, onLoop = function(animation, loops)
      print("LOOP_CALLBACK", loops)
      if loops > 1 then animation:pause() end
    end },
    single = { column = 0, fps = 1 },
    multi = { frames = { { from = 0, to = 1, row = 0 }, { column = 1, row = 1 } }, durations = { 0.1, 0.2, 0.3 } },
  },
})
local Parent = spriteSheet({
  image = "assets/player.png",
  frame = { width = 32, height = 32 },
  animations = { idle = { column = 0, fps = 1 } },
  children = { hat = { sheet = Sheet, initial = "run", x = 4, y = -8 } },
})
return { Sheet = Sheet, Parent = Parent }
