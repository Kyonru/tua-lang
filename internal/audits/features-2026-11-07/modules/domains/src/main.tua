local G = require("game")
local game = G.game
local state = game:get()
local direct = require("game").game
local ds = direct:get()
local N = require("normal")
local n = N.inc(3)
local C = require("components")
local world = ecs.world()
local e = world:create()
world:add(e,C.Position,{x=4})
local position = world:get(e,C.Position)
local x = position.x
print(state.score,ds.score,n,x)
local inline = require("normal").inc
local Position = ecs.component("Position",{x="number"})
world:add(e,Position,{x=5})
local localpos = world:get(e,Position)
local localx = localpos.x
print(localx,inline(2))
