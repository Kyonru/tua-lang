local mathlib = require("mathlib")
describe("math #unit", function()
  before_each(function() end)
  it("typed doubles", function()
    local result: number = mathlib.double(3)
    assert.equals(6, result)
  end)
  context("nested", function()
    it("escaped \x41 name", function() assert.is_true(true) end)
    pending("later")
  end)
end)
describe("mathematics", function()
  it("neighbor", function() assert.equals(2, 2) end)
end)
