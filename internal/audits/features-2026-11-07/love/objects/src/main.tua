local canvas = love.graphics.newCanvas(32, 24)
local font = love.graphics.newFont(12)
local text = love.graphics.newText(font, "hello")
local source = love.audio.newSource(love.sound.newSoundData(100, 44100, 16, 1))
local w, h = canvas:getDimensions()
print(canvas, w, h, source)
canvas:setFilter("nearest", "linear")
canvas:getWidth()
canvas.setFilter("nearest")
text:set("x"):getWidth()
love.graphics.newCanvas(32,24):getWidth()
love.graphics.draw(canvas, 0, 0)
love.graphics.draw(text, 0, 0)
love.graphics.setColor({1,0,0})
source:play()
