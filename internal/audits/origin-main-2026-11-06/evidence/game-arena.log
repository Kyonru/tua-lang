formatting 1.65 [{"newText":"import type { Body } from \"./entities\"\nlocal entities = require(\"entities\")\nlocal player: Body = entities.create(400, 300, 13, 240)\nlocal enemies: Body[] = {}\nlocal elapsed = 0\nlocal spawnClock = 0\nlocal pulseClock = 0\nlocal score = 0\nlocal status = \"playing\"\n\nlocal function reset()\n  player.x = 400\n  player.y = 300\n  enemies = {}\n  elapsed = 0\n  spawnClock = 0\n  pulseClock = 0\n  score = 0\n  status = \"playing\"\nend\n\nlocal function spawnEnemy()\n  local side = math.random(1, 4)\n  local x = math.random(30, 770)\n  local y = math.random(30, 570)\n  if side == 1 then x = 0 elseif side == 2 then x = 800\n  elseif side == 3 then y = 0 else y = 600 end\n  table.insert(enemies, entities.create(x, y, 11, 65 + elapsed * 1.5))\nend\n\nfunction love.load()\n  love.window.setMode(800, 600)\n  love.window.setTitle(\"Pulse Arena — Tua trial\")\n  reset()\nend\n\nfunction love.keypressed(key: string)\n  if key == \"r\" then reset() end\n  if key == \"escape\" then love.event.quit() end\n  if key == \"space\" and status == \"playing\" and pulseClock <= 0 then\n    pulseClock = 2\n    for i = #enemies, 1, -1 do\n      local dx = enemies[i].x - player.x\n      local dy = enemies[i].y - player.y\n      if dx * dx + dy * dy <= 130 * 130 then\n        table.remove(enemies, i)\n        score += 1\n      end\n    end\n  end\nend\n\nfunction love.update(dt: number)\n  if status ~= \"playing\" then return end\n  dt = math.min(dt, 0.05)\n  elapsed += dt\n  spaw
