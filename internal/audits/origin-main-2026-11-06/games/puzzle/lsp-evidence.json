      "result": [
        {
          "newText": "local board = require(\"board\")\nlocal tile: number = 64\nfunction love.load()\n  love.window.setTitle(\"Tua trial: Crate Courier\")\n  love.window.setMode(600, 440)\n  board.reset()\nend\nfunction love.keypressed(key: string)\n  if key == \"r\" then board.reset() end\n  if key == \"escape\" then love.event.quit() end\n  if key == \"left\" or key == \"a\" then board.move(-1, 0) end\n  if key == \"right\" or key == \"d\" then board.move(1, 0) end\n  if key == \"up\" or key == \"w\" then board.move(0, -1) end\n  if key == \"down\" or key == \"s\" then board.move(0, 1) end\nend\nfunction love.draw()\n  love.graphics.clear(0.06, 0.08, 0.12)\n  for y = 1, #board.rows do\n    for x = 1, 8 do\n      if board.wall(x, y) then love.graphics.setColor(0.25, 0.3, 0.4)\n      else love.graphics.setColor(0.12, 0.16, 0.22) end\n      love.graphics.rectangle(\"fill\", 44 + (x - 1) * tile, 30 + (y - 1) * tile, tile - 3, tile - 3)\n    end\n  end\n  love.graphics.setColor(0.2, 0.9, 0.5)\n  love.graphics.circle(\n    \"line\",\n    76 + (board.target.x - 1) * tile,\n    62 + (board.target.y - 1) * tile,\n    23\n  )\n  love.graphics.setColor(0.95, 0.65, 0.2)\n  love.graphics.rectangle(\n    \"fill\",\n    54 + (board.box.x - 1) * tile,\n    40 + (board.box.y - 1) * tile,\n    42,\n    42\n  )\n  love.graphics.setColor(0.4, 0.75, 1)\n  love.graphics.circle(\n    \"fill\",\n    76 + (board.player.x - 1) * tile,\n    62 + (board.player.y - 1) * tile,\n    19\n  )\n  love.graphics.setColor(1, 1, 1)\n  love.graphics.print(\"Arrows/WASD: push crate onto green goal. R: restart\", 44, 365)\n  love.graphics.print(\"Moves: \" .. tostring(board.state.moves), 44, 390)\n  if board.state.won then love.graphics.print(\"Delivered! Press R to play again.\", 180, 390) end\nend\n",
          "range": {
            "end": {
