type Point = { x: number, y: number }
local rows: string[] = { "########", "#      #", "# . $@ #", "#      #", "########" }
local player: Point = { x = 6, y = 3 }
local box: Point = { x = 5, y = 3 }
local target: Point = { x = 3, y = 3 }
local state = { moves = 0, won = false }
local function reset()
  player.x = 6
  player.y = 3
  box.x = 5
  box.y = 3
  state.moves = 0
  state.won = false
end
local function wall(x: number, y: number): boolean
  if y < 1 or y > #rows or x < 1 or x > 8 then return true end
  return string.sub(rows[y], x, x) == "#"
end
local function move(dx: number, dy: number): boolean
  if state.won then return false end
  local x = player.x + dx
  local y = player.y + dy
  if wall(x, y) then return false end
  if x == box.x and y == box.y then
    if wall(box.x + dx, box.y + dy) then return false end
    box.x += dx
    box.y += dy
  end
  player.x = x
  player.y = y
  state.moves += 1
  state.won = box.x == target.x and box.y == target.y
  return true
end
return { rows = rows, player = player, box = box, target = target, state = state, reset = reset, move = move, wall = wall }
