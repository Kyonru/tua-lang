local board = require("board")
local tile: number = 64
function love.load()
  love.window.setTitle("Tua trial: Crate Courier")
  love.window.setMode(600, 440)
  board.reset()
end
function love.keypressed(key: string)
  if key == "r" then board.reset() end
  if key == "escape" then love.event.quit() end
  if key == "left" or key == "a" then board.move(-1, 0) end
  if key == "right" or key == "d" then board.move(1, 0) end
  if key == "up" or key == "w" then board.move(0, -1) end
  if key == "down" or key == "s" then board.move(0, 1) end
end
function love.draw()
  love.graphics.clear(0.06, 0.08, 0.12)
  for y = 1, #board.rows do
    for x = 1, 8 do
      if board.wall(x, y) then love.graphics.setColor(0.25, 0.3, 0.4)
      else love.graphics.setColor(0.12, 0.16, 0.22) end
      love.graphics.rectangle("fill", 44 + (x - 1) * tile, 30 + (y - 1) * tile, tile - 3, tile - 3)
    end
  end
  love.graphics.setColor(0.2, 0.9, 0.5)
  love.graphics.circle("line", 76 + (board.target.x - 1) * tile, 62 + (board.target.y - 1) * tile, 23)
  love.graphics.setColor(0.95, 0.65, 0.2)
  love.graphics.rectangle("fill", 54 + (board.box.x - 1) * tile, 40 + (board.box.y - 1) * tile, 42, 42)
  love.graphics.setColor(0.4, 0.75, 1)
  love.graphics.circle("fill", 76 + (board.player.x - 1) * tile, 62 + (board.player.y - 1) * tile, 19)
  love.graphics.setColor(1, 1, 1)
  love.graphics.print("Arrows/WASD: push crate onto green goal. R: restart", 44, 365)
  love.graphics.print("Moves: " .. tostring(board.state.moves), 44, 390)
  if board.state.won then love.graphics.print("Delivered! Press R to play again.", 180, 390) end
end
