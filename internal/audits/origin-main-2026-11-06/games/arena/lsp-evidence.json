      "result": [
        {
          "newText": "import type { Body } from \"./entities\"\nlocal entities = require(\"entities\")\nlocal player: Body = entities.create(400, 300, 13, 240)\nlocal enemies: Body[] = {}\nlocal elapsed = 0\nlocal spawnClock = 0\nlocal pulseClock = 0\nlocal score = 0\nlocal status = \"playing\"\n\nlocal function reset()\n  player.x = 400\n  player.y = 300\n  enemies = {}\n  elapsed = 0\n  spawnClock = 0\n  pulseClock = 0\n  score = 0\n  status = \"playing\"\nend\n\nlocal function spawnEnemy()\n  local side = math.random(1, 4)\n  local x = math.random(30, 770)\n  local y = math.random(30, 570)\n  if side == 1 then x = 0 elseif side == 2 then x = 800\n  elseif side == 3 then y = 0 else y = 600 end\n  table.insert(enemies, entities.create(x, y, 11, 65 + elapsed * 1.5))\nend\n\nfunction love.load()\n  love.window.setMode(800, 600)\n  love.window.setTitle(\"Pulse Arena — Tua trial\")\n  reset()\nend\n\nfunction love.keypressed(key: string)\n  if key == \"r\" then reset() end\n  if key == \"escape\" then love.event.quit() end\n  if key == \"space\" and status == \"playing\" and pulseClock <= 0 then\n    pulseClock = 2\n    for i = #enemies, 1, -1 do\n      local dx = enemies[i].x - player.x\n      local dy = enemies[i].y - player.y\n      if dx * dx + dy * dy <= 130 * 130 then\n        table.remove(enemies, i)\n        score += 1\n      end\n    end\n  end\nend\n\nfunction love.update(dt: number)\n  if status ~= \"playing\" then return end\n  dt = math.min(dt, 0.05)\n  elapsed += dt\n  spawnClock -= dt\n  pulseClock = math.max(0, pulseClock - dt)\n  local dx = 0\n  local dy = 0\n  if love.keyboard.isDown(\"a\", \"left\") then dx -= 1 end\n  if love.keyboard.isDown(\"d\", \"right\") then dx += 1 end\n  if love.keyboard.isDown(\"w\", \"up\") then dy -= 1 end\n  if love.keyboard.isDown(\"s\", \"down\") then dy += 1 end\n  local length = math.sqrt(dx * dx + dy * dy)\n  if length > 0 then\n    player.x = math.max(15, math.min(785, player.x + dx / length * player.speed * dt))\n    player.y = math.max(15, math.min(585, player.y + dy / length * player.speed * dt))\n  end\n  if spawnClock <= 0 then\n    spawnEnemy()\n    spawnClock = math.max(0.22, 0.9 - elapsed * 0.012)\n  end\n  for _, enemy in ipairs(enemies) do\n    entities.moveToward(enemy, player, dt)\n    if entities.touches(enemy, player) then status = \"lost\" end\n  end\n  if elapsed >= 45 and status == \"playing\" then status = \"won\" end\nend\n\nfunction love.draw()\n  love.graphics.clear(0.035, 0.045, 0.08)\n  love.graphics.setColor(0.12, 0.18, 0.26)\n  for x = 0, 800, 40 do love.graphics.line(x, 0, x, 600) end\n  for y = 0, 600, 40 do love.graphics.line(0, y, 800, y) end\n  if pulseClock <= 0 then\n    love.graphics.setColor(0.15, 0.38, 0.43)\n    love.graphics.circle(\"line\", player.x, player.y, 130)\n  end\n  love.graphics.setColor(0.2, 0.95, 0.8)\n  love.graphics.circle(\"fill\", player.x, player.y, player.radius)\n  love.graphics.setColor(1, 0.32, 0.42)\n  for _, enemy in ipairs(enemies) do\n    love.graphics.circle(\"fill\", enemy.x, enemy.y, enemy.radius)\n  end\n  love.graphics.setColor(1, 1, 1)\n  love.graphics.print(\"PULSE ARENA | Survive 45 seconds\", 20, 15)\n  love.graphics.print(\"WASD / arrows: move   SPACE: pulse   R: restart\", 20, 38)\n  love.graphics.print(\n    \"Time: \" .. math.floor(elapsed) .. \"  Score: \" .. score .. \"  Pulse: \" .. string.format(\"%.1f\", pulseClock),\n    20,\n    61\n  )\n  if status ~= \"playing\" then\n    love.graphics.printf(\n      status == \"won\" and \"SURVIVED! Press R\" or \"CAUGHT! Press R\",\n      0,\n      280,\n      800,\n      \"center\"\n    )\n  end\nend\n\n-- Small inspection seam for the deterministic trial runner; LOVE ignores this return.\nreturn {\n  snapshot = function()\n    return { player = player, enemies = enemies, elapsed = elapsed, score = score, status = status }\n  end,\n}\n",
