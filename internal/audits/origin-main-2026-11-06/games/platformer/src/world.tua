type Body = { x: number, y: number, w: number, h: number }
type Player = { x: number, y: number, w: number, h: number, vx: number, vy: number, grounded: boolean }
local player: Player = { x=40, y=350, w=22, h=30, vx=0, vy=0, grounded=false }
local platforms: Body[] = {
  {x=0,y=430,w=210,h=50}, {x=265,y=370,w=120,h=20},
  {x=440,y=305,w=100,h=20}, {x=590,y=250,w=180,h=20}
}
local goal: Body = {x=720,y=210,w=28,h=40}
local state = { won=false, lost=false, deaths=0 }
local function overlaps(a: Body, b: Body): boolean
  return a.x < b.x+b.w and a.x+a.w > b.x and a.y < b.y+b.h and a.y+a.h > b.y
end
local function reset()
  player.x=40
  player.y=350
  player.vx=0
  player.vy=0
  player.grounded=false
  state.won=false
  state.lost=false
end
local function jump()
  if player.grounded and not state.won and not state.lost then
    player.vy=-420
    player.grounded=false
  end
end
local function update(dt: number, direction: number)
  if state.won or state.lost then return end
  dt=math.min(dt, 1/30)
  local previousBottom = player.y+player.h
  player.vx=direction*210
  player.x=math.max(0, math.min(778, player.x+player.vx*dt))
  player.vy += 1000*dt
  player.y += player.vy*dt
  player.grounded=false
  for _, platform in ipairs(platforms) do
    if player.vy >= 0 and previousBottom <= platform.y and overlaps(player, platform) then
      player.y=platform.y-player.h
      player.vy=0
      player.grounded=true
    end
  end
  if overlaps(player, goal) then state.won=true end
  if player.y > 510 then
    state.lost=true
    state.deaths += 1
  end
end
return {player=player, platforms=platforms, goal=goal, state=state, reset=reset, update=update, jump=jump}
