local world = require("world")
function love.load()
  love.window.setMode(800,480)
  love.window.setTitle("Tua Trial: Rooftop Relay")
  world.reset()
end
function love.update(dt: number)
  local direction=0
  if love.keyboard.isDown("left", "a") then direction -= 1 end
  if love.keyboard.isDown("right", "d") then direction += 1 end
  world.update(dt,direction)
end
function love.keypressed(key: string)
  if key == "space" or key == "up" then world.jump() end
  if key == "r" then world.reset() end
  if key == "escape" then love.event.quit() end
end
function love.draw()
  love.graphics.clear(0.04,0.06,0.12)
  love.graphics.setColor(0.18,0.3,0.45)
  for _, platform in ipairs(world.platforms) do
    love.graphics.rectangle("fill",platform.x,platform.y,platform.w,platform.h)
  end
  love.graphics.setColor(0.2,0.95,0.65)
  love.graphics.rectangle("fill",world.goal.x,world.goal.y,world.goal.w,world.goal.h)
  love.graphics.setColor(1,0.75,0.25)
  love.graphics.rectangle("fill",world.player.x,world.player.y,world.player.w,world.player.h)
  love.graphics.setColor(1,1,1)
  love.graphics.print("ROOFTOP RELAY | A/D or arrows: move | Space: jump | R: restart",16,16)
  love.graphics.print("Reach the green exit. Falls: " .. tostring(world.state.deaths),16,40)
  if world.state.won then love.graphics.print("Delivery complete! Press R to play again.",240,150) end
  if world.state.lost then love.graphics.print("Missed the roof! Press R to retry.",250,150) end
end
