    "result": [
      {
        "newText": "local world = require(\"world\")\nfunction love.load()\n  love.window.setMode(800, 480)\n  love.window.setTitle(\"Tua Trial: Rooftop Relay\")\n  world.reset()\nend\nfunction love.update(dt: number)\n  local direction = 0\n  if love.keyboard.isDown(\"left\", \"a\") then direction -= 1 end\n  if love.keyboard.isDown(\"right\", \"d\") then direction += 1 end\n  world.update(dt, direction)\nend\nfunction love.keypressed(key: string)\n  if key == \"space\" or key == \"up\" then world.jump() end\n  if key == \"r\" then world.reset() end\n  if key == \"escape\" then love.event.quit() end\nend\nfunction love.draw()\n  love.graphics.clear(0.04, 0.06, 0.12)\n  love.graphics.setColor(0.18, 0.3, 0.45)\n  for _, platform in ipairs(world.platforms) do\n    love.graphics.rectangle(\"fill\", platform.x, platform.y, platform.w, platform.h)\n  end\n  love.graphics.setColor(0.2, 0.95, 0.65)\n  love.graphics.rectangle(\"fill\", world.goal.x, world.goal.y, world.goal.w, world.goal.h)\n  love.graphics.setColor(1, 0.75, 0.25)\n  love.graphics.rectangle(\"fill\", world.player.x, world.player.y, world.player.w, world.player.h)\n  love.graphics.setColor(1, 1, 1)\n  love.graphics.print(\"ROOFTOP RELAY | A/D or arrows: move | Space: jump | R: restart\", 16, 16)\n  love.graphics.print(\"Reach the green exit. Falls: \" .. tostring(world.state.deaths), 16, 40)\n  if world.state.won then love.graphics.print(\"Delivery complete! Press R to play again.\", 240, 150) end\n  if world.state.lost then love.graphics.print(\"Missed the roof! Press R to retry.\", 250, 150) end\nend\n",
        "range": {
