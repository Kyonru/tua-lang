import type { InvaderBehavior } from "entities.contracts"
local Player = require("entities.player")
local InvaderInstance = require("entities.invader")

type Shot = { x: number, y: number }
type GameState = { score: number, lives: number, wave: number }

local player = Player.new()
local invaders: InvaderBehavior[] = {}
local shots: Shot[] = {}
local state: GameState = { score = 0, lives = 3, wave = 1 }
local direction = 1
local fireCooldown = 0

local function spawnWave(wave: number): InvaderBehavior[]
  local result: InvaderBehavior[] = {}
  local speed = 24 + wave * 6
  for row = 0, 2 do
    for col = 0, 7 do
      table.insert(result, InvaderInstance.new(100 + col * 72, 90 + row * 44, speed))
    end
  end
  return result
end

local function update(dt: number): nil
  player:update(dt)
  for _, enemy in ipairs(invaders) do
    if enemy:wouldHitEdge(dt, direction) then
      direction = -direction
      break
    end
  end
  for _, enemy in ipairs(invaders) do
    enemy:update(dt, direction)
  end
  fireCooldown = math.max(0, fireCooldown - dt)
  if love.keyboard.isDown("space") and fireCooldown == 0 then
    local position = player:shoot()
    if #position == 2 then
      table.insert(shots, { x = position[1], y = position[2] })
    end
    fireCooldown = 0.12
  end
  for shotIndex = #shots, 1, -1 do
    local shot = shots[shotIndex]
    shot.y -= 360 * dt
    if shot.y + 12 < 0 then
      table.remove(shots, shotIndex)
    else
      for _, enemy in ipairs(invaders) do
        if enemy:hit(shot.x, shot.y) then
          table.remove(shots, shotIndex)
          state.score += 10
          break
        end
      end
    end
  end
  for i = #invaders, 1, -1 do
    if not invaders[i]:isAlive() then table.remove(invaders, i) end
  end
  if #invaders == 0 then
    state.wave += 1
    invaders = spawnWave(state.wave)
  end
end

local function draw(): nil
  player:draw()
  for _, enemy in ipairs(invaders) do enemy:draw() end
  for _, shot in ipairs(shots) do
    love.graphics.rectangle("fill", shot.x - 2, shot.y, 4, 12)
  end
  love.graphics.print("Score: " .. state.score .. "   Wave: " .. state.wave, 16, 16)
end

return {
  load = function() invaders = spawnWave(state.wave) end,
  update = update,
  draw = draw,
  state = state,
}
