import type { InvaderBehavior } from "entities.contracts"

final class Invader implements InvaderBehavior {
  x: number
  y: number
  speed: number
  alive: boolean = true

  init(x: number, y: number, speed: number) {
    self.x = x
    self.y = y
    self.speed = speed
  }

  wouldHitEdge(dt: number, direction: number): boolean {
    local nextX = self.x + self.speed * dt * direction
    return nextX > 770 or nextX < 30
  }

  update(dt: number, direction: number): nil {
    self.x += self.speed * dt * direction
  }

  draw(): nil {
    if self.alive then
      love.graphics.rectangle("line", self.x - 12, self.y - 9, 24, 18)
    end
  }

  hit(x: number, y: number): boolean {
    if self.alive and math.abs(x - self.x) < 15 and math.abs(y - self.y) < 12 then
      self.alive = false
      return true
    end
    return false
  }

  isAlive(): boolean {
    return self.alive
  }
}

export type InvaderInstance = Invader

return Invader
