export protocol Tickable {
  update(dt: number): nil
}

open class Actor {
  elapsed: number = 0
  update(dt: number): nil { self.elapsed += dt }
}

final class Defender extends Actor implements Tickable {
  init() { super() }
  override update(dt: number): nil { self.elapsed += dt }
}

export type ActorInstance = Actor
export type DefenderInstance = Defender
return { Defender = Defender }
