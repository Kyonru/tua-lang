open class Base {
  elapsed: number = 0
  speed: number = 0

  update(dt: number): nil { self.elapsed += dt }
}

final class FastInline extends Base {
  init() { super(); self.speed = 120 }

  override update(dt: number): nil { self.elapsed += dt }
}

final class FastMultiline extends Base {
  init() {
    super()
    self.speed = 120
  }

  override update(dt: number): nil { self.elapsed += dt }
}

return { inline = FastInline.new().speed, multiline = FastMultiline.new().speed }
