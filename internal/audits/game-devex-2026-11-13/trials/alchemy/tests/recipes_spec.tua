import type { ReagentInstance, ElementInstance, JarInstance } from "model"
local Model = require("model")
local Recipes = require("recipes")

describe("alchemy recipe model", function()
  it("combines an unordered pair and dispatches through a base class", function()
    local elements: ElementInstance[] = Recipes.ingredients()
    local potion = Recipes.mix(elements[4], elements[3])
    assert.is_not_nil(potion)
    if potion then
      local reagents: ReagentInstance[] = { elements[3], potion }
      assert.equals("Fire", reagents[1]:name())
      assert.equals("Steam potion", reagents[2]:name())
      assert.equals(10, potion.score)
    end
  end)

  it("keeps a specialized imported generic jar", function()
    local element = Model.Element.new("Air", "#a5d7ff")
    local jar: JarInstance < ElementInstance > = Recipes.seal(element)
    assert.equals("Air", jar:label())
    assert.equals("#a5d7ff", jar:get().color)
  end)

  it("returns nil for an absent recipe", function()
    local elements: ElementInstance[] = Recipes.ingredients()
    assert.is_nil(Recipes.mix(elements[1], elements[1]))
  end)
end)
