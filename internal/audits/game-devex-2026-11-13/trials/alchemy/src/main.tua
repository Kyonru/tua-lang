import type { ElementInstance, PotionInstance, JarInstance } from "./model"
local Recipes = require("recipes")
local Legacy = require("legacy")

type Spark = { x: number, y: number, age: number, vx: number, vy: number }
type Assistant = { failures: number, hint: string }

local ingredients: ElementInstance[] = Recipes.ingredients()
local leftIndex = 1
local rightIndex = 2
local lastPotion: PotionInstance | nil = nil
local challenge = 1
local rng = Rot.Rng.new(817)
local maze = Rot.Map.generate(15, 11, "sidewinder", rng)
local routes = Rot.Path.astar(maze, 2, 2, 14, 10)
local roomTint = Rot.Color.parse("#192942")
local cauldron: Vec2 = vec2(400, 300)
local auraRadius: number = (cauldron - vec2(400, 280)).length

local status = store({ score = 0, discovered = 0, message = "Choose two elements and brew." })
local banner = { y = -25, alpha = 0 }
status:watch("score", function(score: number, previous: number)
  if score > previous then
    banner.y = -25
    banner.alpha = 1
    tween.to(banner, 0.7, { y = 18, alpha = 0 }):ease("quadout")
  end
end)

local phase = stateMachine({
  initial = "ready",
  events = {
    { name = "brew", from = "ready", to = "showing" },
    { name = "reject", from = "ready", to = "failed" },
    { name = "again", from = { "showing", "failed" }, to = "ready" },
  },
})

local controls = input({
  controls = {
    leftPrev = { "key:q" }, leftNext = { "key:e" },
    rightPrev = { "key:a" }, rightNext = { "key:d" },
    confirm = { "key:return", "key:space", "button:a" },
  },
})

local Ring = spriteSheet({
  image = "assets/ring.png",
  frame = { width = 16, height = 16 },
  origin = { x = 8, y = 8 },
  animations = { glow = { from = 0, to = 3, row = 0, fps = 6 } },
})
local ring = Ring:player("glow")

local Position = ecs.component("Position", { x = "number", y = "number" })
local SparkData = ecs.component("SparkData", {
  x = "number", y = "number", age = "number", vx = "number", vy = "number",
})
local world = ecs.world()
local sparks = objectPool({
  create = function(): Spark
    return { x = 0, y = 0, age = 0, vx = 0, vy = 0 }
  end,
  reset = function(spark: Spark)
    spark.x = 0
    spark.y = 0
    spark.age = 0
    spark.vx = 0
    spark.vy = 0
  end,
  initial = 24,
})
local sparkSystem = ecs.system(world, { Position, SparkData }, function(entity, position, spark, dt)
  position.x += spark.vx * dt
  position.y += spark.vy * dt
  spark.age += dt
  if spark.age > 0.6 then
    world:destroy(entity)
    sparks:release(spark)
  end
end)
local drawSparks = ecs.system(world, { Position, SparkData }, function(_, position, spark)
  love.graphics.setColor(0.95, 0.75, 0.35, Legacy.clamp(1 - spark.age / 0.6, 0, 1))
  love.graphics.circle("fill", position.x, position.y, 3)
end)

local assistant: Assistant = { failures = 0, hint = "" }
local helpTree = BehaviorTree.new(BehaviorTree.reactiveSelector({
  BehaviorTree.sequence({
    BehaviorTree.condition(function(context: Assistant)
      return context.failures >= 2
    end),
    BehaviorTree.action(function(context: Assistant)
      context.hint = "Hint: try Fire + Water."
      return "success"
    end),
  }),
  BehaviorTree.action(function(context: Assistant)
    context.hint = "Mix two different elements."
    return "running"
  end),
}))
local helpRunner = helpTree:instance(assistant)

local events = signal()
local tone = AudioDesign.render({ waveform = "sine", frequency = 620,
  duration = 0.24, gain = 0.27,
  envelope = { attack = 0.005, decay = 0.12, sustain = 0, release = 0.08 } })
local audio = audioSystem({
  buses = { master = { volume = 0.5 }, sfx = { parent = "master", maxVoices = 5 },
    music = { parent = "master", maxVoices = 1 } },
  cues = { brew = { source = tone, bus = "sfx", maxVoices = 3 },
    fail = { source = sound("assets/bump.ogg"), bus = "sfx" } },
  music = { lab = { bpm = 90, signature = { 4, 4 },
    layers = { hum = { source = music("assets/bump.ogg") } } } },
})
local shaders = ShaderScan.new()
local camera = Camera.new({ style = "platformer", smoothing = 8 })
local uiFont: Font | nil = nil
local elapsed = 0
local smoke = os.getenv("TUA_ALCHEMY_SMOKE") == "1"
local hotSmoke = os.getenv("TUA_ALCHEMY_HOT_SMOKE") == "1"
local initialShader: Shader | nil = nil
if smoke or hotSmoke then
  function love.errorhandler(message)
    print("LOVE_ERROR:", message)
    os.exit(1)
  end
end

local function spawnSparks()
  for i = 1, 12 do
    local particle = sparks:acquire()
    particle.x = cauldron.x
    particle.y = cauldron.y
    particle.vx = (i - 6) * 24
    particle.vy = -60 - Rot.Dice.roll("1d6", rng) * 10
    local entity = world:create()
    world:add(entity, Position, { x = particle.x, y = particle.y })
    world:add(entity, SparkData, particle)
  end
end

events:on("potion.brewed", function(potion: PotionInstance)
  local jar: JarInstance < PotionInstance > = Recipes.seal(potion)
  lastPotion = jar:get()
  status:update(function(state)
    state.score += potion.score
    state.discovered += 1
    state.message = "Created " .. jar:label() .. "!"
  end)
  assistant.failures = 0
  helpRunner:reset()
  spawnSparks()
  local _, playback = audio:play("brew")
  if playback == "rejected" then print("Brew cue voice limit reached") end
  camera:shake(0.18)
end)

local function cycle(index: number, delta: number): number
  return ((index - 1 + delta + #ingredients) % #ingredients) + 1
end

local function brew()
  if phase.current ~= "ready" then
    phase:again()
    return
  end
  local potion = Recipes.mix(ingredients[leftIndex], ingredients[rightIndex])
  if potion then
    phase:brew()
    events:emit("potion.brewed", potion)
  else
    phase:reject()
    assistant.failures += 1
    status:update(function(state)
      state.message = "No recipe for that pair. Press Enter to try again."
    end)
    audio:play("fail")
  end
end

function love.load()
  if smoke then print("SMOKE: love.load") end
  love.window.setMode(800, 600, { resizable = false })
  love.window.setTitle("Tua Alchemy Trial")
  uiFont = love.graphics.newFont("assets/sniglet.otf", 26)
  audio:setMusicState("lab")
  local ok, message = pcall(function()
    shaders:load_shader("pulse", "assets/pulse.glsl")
  end)
  if not ok then print("Shader load:", message) end
  if smoke then print("SMOKE: shader attempted", shaders.s.pulse ~= nil) end
  if hotSmoke then
    initialShader = shaders.s.pulse
    assert(initialShader ~= nil)
    print("HOT: initial shader loaded")
    io.stdout:flush()
  end
  local roll = Rot.Dice.roll("1d4", rng)
  challenge = roll
  if smoke then
    leftIndex = 3
    rightIndex = 4
    brew()
    assert(phase.current == "showing")
    assert(not phase:can("brew"))
    assert(status:get().score == 10)
    assert(sparks:activeCount() == 12)
    assert(audio:snapshot().music.state == "lab")
    assert(auraRadius == 20)
    print("SMOKE: recipe, signal, store, ECS, pool passed")
  end
end

function love.update(dt: number)
  controls:update()
  if controls:pressed("leftPrev") then leftIndex = cycle(leftIndex, -1) end
  if controls:pressed("leftNext") then leftIndex = cycle(leftIndex, 1) end
  if controls:pressed("rightPrev") then rightIndex = cycle(rightIndex, -1) end
  if controls:pressed("rightNext") then rightIndex = cycle(rightIndex, 1) end
  if controls:pressed("confirm") then brew() end
  helpRunner:update(dt)
  sparkSystem:update(dt)
  tween.update(dt)
  ring:update(dt)
  audio:update(dt)
  shaders:update(dt)
  camera:follow(cauldron.x, cauldron.y)
  camera:update(dt)
  elapsed += dt
  if hotSmoke then
    if shaders.s.pulse ~= initialShader then
      print("HOT: included shader reloaded")
      love.event.quit()
    elseif elapsed > 5 then
      error("included shader did not hot reload within five seconds")
    end
  end
  if smoke and elapsed > 0.75 then
    assert(sparks:activeCount() == 0)
    assert(assistant.hint == "Mix two different elements.")
    local screenX, screenY = camera:toScreen(cauldron.x, cauldron.y)
    local worldX, worldY = camera:toWorld(screenX, screenY)
    assert(math.abs(worldX - cauldron.x) < 0.1)
    assert(math.abs(worldY - cauldron.y) < 0.1)
    print("SMOKE: pool release passed")
    love.event.quit()
  end
end

function love.draw()
  love.graphics.clear(roomTint.r, roomTint.g, roomTint.b)
  camera:draw(function()
    for y = 1, 11 do
      for x = 1, 15 do
        if maze:get(x, y) then
          love.graphics.setColor(0.17, 0.27, 0.37)
          love.graphics.rectangle("fill", x * 30 + 150, y * 30 + 130, 27, 27)
        end
      end
    end
    local pulse = shaders.s.pulse
    if pulse then
      ShaderScan.safe_send(pulse, "time", elapsed)
      love.graphics.setShader(pulse)
    end
    love.graphics.setColor(0.45, 0.18, 0.65)
    love.graphics.circle("fill", cauldron.x, cauldron.y, 32 + auraRadius)
    love.graphics.setShader()
    love.graphics.setColor(1, 1, 1)
    ring:draw(cauldron.x, cauldron.y)
    drawSparks:update(0)
  end)
  if uiFont then love.graphics.setFont(uiFont) end
  love.graphics.setColor(0.96, 0.95, 0.88)
  love.graphics.print("THE LITTLE ALCHEMIST", 40, 26)
  love.graphics.setColor(0.72, 0.83, 0.93)
  love.graphics.print("Q/E: left   A/D: right   Enter: brew / continue", 40, 72)
  love.graphics.setColor(1, 1, 1)
  love.graphics.printf(
    ingredients[leftIndex]:name() .. " + " .. ingredients[rightIndex]:name(),
    0,
    455,
    800,
    "center"
  )
  local state = status:get()
  love.graphics.printf(state.message, 0, 495, 800, "center")
  love.graphics.print("Score: " .. state.score .. "   New potions: " .. state.discovered, 40, 550)
  love.graphics.print("Assistant: " .. assistant.hint, 40, 112)
  love.graphics.print("Seeded challenge: " .. challenge, 40, 150)
  if routes then love.graphics.print("Lab path: " .. #routes .. " steps", 40, 188) end
  if lastPotion then love.graphics.print("Last: " .. lastPotion:name(), 40, 225) end
  love.graphics.setColor(1, 0.86, 0.38, Legacy.clamp(banner.alpha, 0, 1))
  love.graphics.print("+ recipe discovered", 530, banner.y)
end
