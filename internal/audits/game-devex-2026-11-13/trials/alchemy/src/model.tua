-- Pure model: safe to load under Busted and ordinary Lua.
export protocol Named {
  name(): string
}

open class Reagent implements Named {
  label: string

  init(label: string) {
    self.label = label
  }

  name(): string {
    return self.label
  }
}

final class Element extends Reagent {
  color: string

  init(label: string, color: string) {
    super(label)
    self.color = color
  }
}

final class Potion extends Reagent {
  score: number

  init(label: string, score: number) {
    super(label)
    self.score = score
  }

  override name(): string {
    return self.label .. " potion"
  }
}

final class Jar < T > {
  item: T
  itemLabel: string

  init(item: T, itemLabel: string) {
    self.item = item
    self.itemLabel = itemLabel
  }

  label(): string {
    return self.itemLabel
  }

  get(): T {
    return self.item
  }
}

export type ReagentInstance = Reagent
export type ElementInstance = Element
export type PotionInstance = Potion
export type JarInstance < T > = Jar < T >

  return { Reagent = Reagent, Element = Element, Potion = Potion, Jar = Jar }
