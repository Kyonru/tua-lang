import type { ActorInstance, Alertable, GuardInstance } from "./actors"
local Actors = require("actors")

local function alarm<T: Alertable>(subject: T, amount: number): T
  subject:raise(amount)
  return subject
end

local function throughAlias(guard: GuardInstance): string
  local actors: ActorInstance[] = { guard }
  return actors[1]:label()
end

local direct: ActorInstance[] = { Actors.Guard.new(2, 2) }
assert(direct[1]:label() == "guard")
assert(throughAlias(Actors.Guard.new(2, 2)) == "guard")
