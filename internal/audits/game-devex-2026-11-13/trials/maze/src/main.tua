import type { GuardInstance, LedgerInstance } from "./game/actors"
local Rules = require("game.rules")
local Maze = require("game.maze_logic")

local TILE = 32
local board = Maze.make(817)
local player: Vec2 = vec2(2, 2)
local guard: GuardInstance = Rules.newGuard(12, 8)
local tracked: LedgerInstance < GuardInstance > = Rules.ledgerForGuard(guard)
type AlertSource = "guard" | "camera"
local lastAlert: AlertSource | nil = nil
local status = store({
  steps = 0,
  stuns = 1,
  alert = false,
  escaped = false,
  lost = false,
  message = "Find the exit",
})
local events = signal()
local phase = stateMachine({
  initial = "search",
  events = {
    { name = "spot", from = "search", to = "alert" },
    { name = "escape", from = { "search", "alert" }, to = "won" },
    { name = "caught", from = "alert", to = "lost" },
    { name = "reset", from = { "won", "alert", "lost" }, to = "search" },
  },
})

local controls = input({
  controls = {
    left = { "key:left", "key:a" }, right = { "key:right", "key:d" },
    up = { "key:up", "key:w" }, down = { "key:down", "key:s" },
    restart = { "key:r" }, stun = { "key:space" },
  },
  pairs = { move = { "left", "right", "up", "down" } },
})

local sheet = spriteSheet({
  image = "assets/block.png",
  frame = { width = 64, height = 64 },
  origin = { x = 32, y = 32 },
  animations = {
    idle = { column = 0, row = 0, durations = 1 },
    walk = { from = 0, to = 1, row = 0, fps = 6 },
  },
})
local playerSprite = sheet:player("idle")
local camera = Camera.new({ style = "topdown", smoothing = 10 })
local shaders = ShaderScan.new()
local banner = { alpha = 0 }

local Position = ecs.component("Position", { x = "number", y = "number" })
local Brain = ecs.component("Brain", { context = "any", runner = "any" })
local Spark = ecs.component("Spark", { x = "number", y = "number", age = "number" })
local world = ecs.world()
local guardEntity = world:create()
world:add(guardEntity, Position, { x = guard.x, y = guard.y })

type SparkValue = { x: number, y: number, age: number }
local sparks = objectPool({
  create = function(): SparkValue return { x = 0, y = 0, age = 0 } end,
  reset = function(spark: SparkValue)
    spark.x = 0
    spark.y = 0
    spark.age = 0
  end,
  initial = 8,
})

type GuardContext = {
  guard: GuardInstance,
  seesPlayer: boolean,
  stepTimer: number,
  patrolToExit: boolean,
}
local guardContext: GuardContext = {
  guard = guard,
  seesPlayer = false,
  stepTimer = 0,
  patrolToExit = true,
}
local stunTimer = 0
local guardTree = BehaviorTree.new(BehaviorTree.reactiveSelector({
  BehaviorTree.sequence({
    BehaviorTree.condition(function(ctx: GuardContext) return ctx.seesPlayer end),
    BehaviorTree.action(function(ctx: GuardContext)
      if ctx.stepTimer > 0 then return "running" end
      local nextTile = Maze.nextStep(board.grid, ctx.guard.x, ctx.guard.y, player.x, player.y)
      ctx.guard:move(nextTile.x - ctx.guard.x, nextTile.y - ctx.guard.y)
      ctx.stepTimer = 0.35
      return "success"
    end),
  }),
  BehaviorTree.action(function(ctx: GuardContext)
    if ctx.stepTimer > 0 then return "running" end
    local goalX, goalY = ctx.patrolToExit and 14 or 2, ctx.patrolToExit and 10 or 2
    local nextTile = Maze.nextStep(board.grid, ctx.guard.x, ctx.guard.y, goalX, goalY)
    if nextTile.x == ctx.guard.x and nextTile.y == ctx.guard.y then
      ctx.patrolToExit = not ctx.patrolToExit
    else
      ctx.guard:move(nextTile.x - ctx.guard.x, nextTile.y - ctx.guard.y)
    end
    ctx.stepTimer = 0.5
    return "success"
  end),
}))
local guardRunner = guardTree:instance(guardContext)
world:add(guardEntity, Brain, { context = guardContext, runner = guardRunner })

local brainSystem = ecs.system(world, { Brain, Position }, function(_, brain, position, dt)
  local ctx: GuardContext = brain.context
  ctx.stepTimer = math.max(0, ctx.stepTimer - dt)
  ctx.seesPlayer = Maze.canSee(board.grid, ctx.guard.x, ctx.guard.y, player.x, player.y)
  if stunTimer <= 0 then brain.runner:update(dt) end
  position.x = ctx.guard.x
  position.y = ctx.guard.y
  if ctx.seesPlayer and not status:get().alert then events:emit("guard.spotted", 1) end
  if stunTimer <= 0 and ctx.guard.x == player.x and ctx.guard.y == player.y and not status:get().escaped and not status:get().lost then
    if phase.current == "alert" then phase:caught() end
    status:update(function(state)
      state.lost = true
      state.message = "Caught! Press R to retry"
    end)
  end
end)

local sparkSystem = ecs.system(world, { Spark }, function(entity, spark, dt)
  spark.age += dt
  if spark.age >= 0.25 then
    world:destroy(entity)
    sparks:release(spark)
  end
end)

local stepSound = sound("assets/step.ogg")
local alarmSound: Source = AudioDesign.render({
  waveform = "saw", duration = 0.16, gain = 0.3, seed = 12,
  envelope = { attack = 0.005, decay = 0.1, sustain = 0, release = 0.04 },
})
local ambientSound: Source = AudioDesign.render({
  waveform = "sine", duration = 1, gain = 0.1, seed = 13,
  envelope = { attack = 0.02, decay = 0.2, sustain = 0.15, release = 0.1 },
})
local audio = audioSystem({
  buses = { master = { volume = 1 }, sfx = { parent = "master", maxVoices = 4 } },
  cues = {
    step = { source = stepSound, bus = "sfx", maxVoices = 2 },
    alarm = { source = alarmSound, bus = "sfx", maxVoices = 1 },
  },
  music = { tension = { bpm = 100, layers = { drone = { source = ambientSound } } } },
})

events:on("guard.spotted", function(amount: number)
  lastAlert = "guard"
  guard:raise(amount)
  if phase.current == "search" then phase:spot() end
  status:update(function(state)
    state.alert = true
    state.message = Rules.describe(tracked:get())
  end)
  audio:play("alarm")
  audio:setMusicState("tension")
  camera:shake(0.3)
end)

status:watch("alert", function(alert: boolean)
  if alert then tween.to(banner, 0.25, { alpha = 1 }):ease("quadout") end
end)

local moveDelay = 0
local smokeFrames = 0
local routeSmokeIndex = 2

local function movePlayer(dx: number, dy: number)
  local nextX, nextY = player.x + dx, player.y + dy
  if not board.grid:get(nextX, nextY) then return end
  player.x, player.y = nextX, nextY
  playerSprite:play("walk")
  status:update(function(state) state.steps += 1 end)
  local spark = sparks:acquire()
  spark.x, spark.y, spark.age = nextX, nextY, 0
  world:add(world:create(), Spark, spark)
  audio:play("step")
  if nextX == 14 and nextY == 10 then
    phase:escape()
    status:update(function(state)
      state.escaped = true
      state.message = "Escaped in " .. tostring(state.steps) .. " steps"
    end)
  end
end

local function stunGuard()
  if status:get().stuns <= 0 or status:get().escaped or status:get().lost then return end
  local distance = Rules.pointDistance({ x = player.x, y = player.y }, { x = guard.x, y = guard.y })
  if distance > 3 then return end
  stunTimer = 2
  status:update(function(state) state.stuns -= 1 end)
  audio:play("alarm")
end

local function resetGame()
  if phase.current == "alert" or phase.current == "won" or phase.current == "lost" then phase:reset() end
  player.x, player.y = 2, 2
  guard.x, guard.y = 12, 8
  guardContext.patrolToExit = true
  guardRunner:reset()
  stunTimer = 0
  lastAlert = nil
  banner.alpha = 0
  status:set({
    steps = 0,
    stuns = 1,
    alert = false,
    escaped = false,
    lost = false,
    message = "Find the exit",
  })
  audio:stopBus("sfx")
end

function love.load()
  love.window.setMode(640, 480)
  love.graphics.setBackgroundColor(0.07, 0.09, 0.12)
  local ok, message = pcall(function()
    shaders:load_shader("fog", "shaders/fog.glsl")
  end)
  if not ok then print("shader load", message) end
end

function love.update(dt: number)
  controls:update()
  stunTimer = math.max(0, stunTimer - dt)
  moveDelay = math.max(0, moveDelay - dt)
  if controls:pressed("restart") then resetGame() end
  if controls:pressed("stun") then stunGuard() end
  if moveDelay <= 0 and not status:get().escaped and not status:get().lost then
    local dx, dy = controls:get("move")
    if math.abs(dx) > math.abs(dy) and dx ~= 0 then
      movePlayer(dx > 0 and 1 or -1, 0)
      moveDelay = 0.14
    elseif dy ~= 0 then
      movePlayer(0, dy > 0 and 1 or -1)
      moveDelay = 0.14
    else
      playerSprite:play("idle")
    end
  end
  playerSprite:update(dt)
  brainSystem:update(dt)
  sparkSystem:update(dt)
  tween.update(dt)
  camera:follow(player.x * TILE, player.y * TILE)
  camera:update(dt)
  audio:update(dt)
  shaders:update(dt)
  if os.getenv("TUA_MAZE_ROUTE_SMOKE") == "1" then
    local distance = Rules.pointDistance(
      { x = player.x, y = player.y },
      { x = guard.x, y = guard.y }
    )
    if distance <= 3 then stunGuard() end
    if not status:get().lost and not status:get().escaped and routeSmokeIndex <= #board.path then
      local tile = board.path[routeSmokeIndex]
      movePlayer(tile.x - player.x, tile.y - player.y)
      routeSmokeIndex += 1
    end
    if status:get().lost or status:get().escaped or routeSmokeIndex > #board.path then
      print(
        "TUA_MAZE_ROUTE_RESULT",
        phase.current,
        status:get().steps,
        status:get().alert,
        sparks:activeCount()
      )
      love.event.quit(0)
    end
  end
  if os.getenv("TUA_MAZE_SMOKE") == "1" then
    smokeFrames += 1
    if smokeFrames == 4 then
      print(
        "TUA_MAZE_SMOKE_OK",
        board.grid.width,
        board.grid.height,
        #board.path,
        guard:label(),
        sparks:activeCount(),
        guard.x,
        guard.y,
        shaders.s.fog ~= nil
      )
      love.event.quit(0)
    end
  end
end

function love.draw()
  camera:draw(function()
    local fog = shaders.s.fog
    if fog then
      ShaderScan.safe_send(fog, "tintColor", { 0.8, 0.85, 1, 1 })
      love.graphics.setShader(fog)
    end
    for y = 1, board.grid.height do
      for x = 1, board.grid.width do
        if board.grid:get(x, y) then
          love.graphics.setColor(0.17, 0.25, 0.28, 1)
        else
          love.graphics.setColor(0.04, 0.06, 0.08, 1)
        end
        love.graphics.rectangle("fill", x * TILE, y * TILE, TILE - 1, TILE - 1)
      end
    end
    love.graphics.setShader()
    love.graphics.setColor(1, 1, 1, 1)
    playerSprite:draw(player.x * TILE, player.y * TILE, 0, 0.5)
    love.graphics.setColor(1, 0.25, 0.24, 1)
    love.graphics.circle("fill", guard.x * TILE, guard.y * TILE, 12)
    love.graphics.setColor(0.2, 1, 0.6, 1)
    love.graphics.rectangle("line", 14 * TILE, 10 * TILE, TILE, TILE)
  end)
  love.graphics.setColor(1, 1, 1, 1)
  love.graphics.print("WASD / arrows: move  Space: stun  R: restart", 12, 12)
  love.graphics.print(status:get().message, 12, 32)
  love.graphics.print("Stuns: " .. status:get().stuns, 470, 32)
  if lastAlert then love.graphics.print("Source: " .. lastAlert, 210, 32) end
  love.graphics.setColor(1, 0.2, 0.2, banner.alpha)
  love.graphics.print("ALERT", 12, 55)
  love.graphics.setColor(1, 1, 1, 1)
end
