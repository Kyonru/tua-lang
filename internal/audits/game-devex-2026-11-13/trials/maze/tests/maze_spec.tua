import type { GuardInstance } from "game.actors"
local Maze = require("game.maze_logic")
local Rules = require("game.rules")

describe("seeded stealth rules #unit", function()
  it("repeats the same route for a seed", function()
    local first = Maze.make(817)
    local second = Maze.make(817)
    assert.is_not_nil(first.path)
    assert.equals(#first.path, #second.path)
    for i = 1, #first.path do
      assert.equals(first.path[i].x, second.path[i].x)
      assert.equals(first.path[i].y, second.path[i].y)
    end
  end)

  it("moves the guard by one walkable route tile", function()
    local board = Maze.make(817)
    assert.is_true(board.grid:get(12, 8))
    local nextTile = Maze.nextStep(board.grid, 2, 2, 14, 10)
    assert.is_true(board.grid:get(nextTile.x, nextTile.y))
    assert.equals(1, Rules.pointDistance({ x = 2, y = 2 }, nextTile))
  end)

  it("dispatches a subclass label through an imported factory", function()
    local guard: GuardInstance = Rules.newGuard(12, 8)
    assert.equals("guard danger 1", Rules.describe(guard))
    assert.equals(1, guard:level())
    guard:move(1, 0)
    assert.equals(13, guard.x)
    local ledger = Rules.ledgerForGuard(guard)
    assert.equals(guard, ledger:get())
  end)
end)
