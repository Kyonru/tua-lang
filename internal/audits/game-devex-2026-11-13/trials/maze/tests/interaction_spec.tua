local Maze = require("game.maze_logic")
local Brain = ecs.component("Brain", { runner = "any", context = "any" })

describe("stealth runtime composition #unit", function()
  it("carries a behavior decision through ECS, signal, store, state machine and pool", function()
    local board = Maze.make(817)
    local eventBus = signal()
    local state = store({ alert = false, notices = 0 })
    local phase = stateMachine({
      initial = "quiet",
      events = { { name = "spot", from = "quiet", to = "alert" } },
    })
    type Flash = { age: number }
    local pool = objectPool({
      create = function(): Flash return { age = 0 } end,
      reset = function(value: Flash) value.age = 0 end,
      initial = 1,
    })
    local world = ecs.world()
    local context = { sees = Maze.canSee(board.grid, 12, 8, 12, 8), emit = false }
    local tree = BehaviorTree.new(BehaviorTree.reactiveSelector({
      BehaviorTree.sequence({
        BehaviorTree.condition(function(actor) return actor.sees end),
        BehaviorTree.action(function(actor)
          actor.emit = true
          return "success"
        end),
      }),
      BehaviorTree.action(function() return "running" end),
    }))
    local entity = world:create()
    local runner = tree:instance(context)
    world:add(entity, Brain, { runner = runner, context = context })
    eventBus:on("guard.spotted", function(amount: number)
      state:update(function(snapshot)
        snapshot.alert = true
        snapshot.notices += amount
      end)
      if phase.current == "quiet" then phase:spot() end
    end)
    local brains = ecs.system(world, { Brain }, function(_, brain, dt)
      brain.runner:update(dt)
      if brain.context.emit then
        brain.context.emit = false
        eventBus:emit("guard.spotted", 1)
      end
    end)

    brains:update(1 / 60)
    assert.is_true(state:get().alert)
    assert.equals(1, state:get().notices)
    assert.equals("alert", phase.current)
    local flash = pool:acquire()
    flash.age += 0.25
    assert.equals(1, pool:activeCount())
    assert.is_true(pool:release(flash))
    assert.equals(0, pool:activeCount())
    runner:cancel()
    world:destroy(entity)
  end)
end)
