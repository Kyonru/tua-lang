local score = store({ points = 0 })
local events = signal()
local round = stateMachine({
  initial = "playing",
  events = { { name = "pause", from = "playing", to = "paused" } },
})
local notices = 0
local stop = score:watch("points", function(value: number, previous: number)
  assert(value >= previous)
  notices += 1
end)
events:on("score", function(amount: number)
  score:update(function(state)
    state.points += amount
  end)
  if score:get().points >= 10 then round:pause() end
end)
events:emit("score", 6)
events:emit("score", 4)
stop()
events:emit("score", 1)
assert(score:get().points == 11)
assert(notices == 2)
assert(round.current == "paused")
return { points = score:get().points, notices = notices, current = round.current }
