import type { Combinable } from "./contracts"

final class RecipeBook implements Combinable {
  combine(first: string, second: string): string | nil {
    local a = first
    local b = second
    if a > b then
      a = second
      b = first
    end
    if a == "fire" and b == "water" then return "steam" end
    if a == "earth" and b == "water" then return "mud" end
    if a == "air" and b == "fire" then return "energy" end
    if a == "air" and b == "water" then return "rain" end
    if a == "earth" and b == "fire" then return "lava" end
    if a == "fire" and b == "mud" then return "brick" end
    if a == "energy" and b == "steam" then return "life" end
    return nil
  }
}

return { RecipeBook = RecipeBook }
