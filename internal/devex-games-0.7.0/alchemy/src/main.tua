import type { Combinable } from "./contracts"
import type { SlotInstance } from "./model"

local Model = require("model")
local Recipes = require("recipes")

local book: Combinable = Recipes.RecipeBook.new()
local elements: string[] = { "air", "earth", "fire", "water" }
local discoveries: string[] = {}
local selected: SlotInstance < string > | nil = nil
local message = "Pick two elements to combine"

local function hasElement(name: string): boolean
  for _, element in ipairs(elements) do
    if element == name then return true end
  end
  return false
end

local function combine(first: string, second: string): string | nil
  local result = book:combine(first, second)
  if result == nil then
    message = first .. " + " .. second .. " = ?"
    return nil
  end
  if not hasElement(result) then
    elements[#elements + 1] = Model.remember(result, discoveries)
  end
  message = first .. " + " .. second .. " = " .. result
  return result
end

local function choose(name: string)
  if selected == nil then
    selected = Model.Slot.new(name)
    message = "Selected " .. name .. ". Pick another element."
    return
  end
  local first = selected:get()
  selected = nil
  combine(first, name)
end

function love.load()
  love.window.setTitle("Tua 0.7 Alchemy")
  love.window.setMode(640, 480)
end

function love.mousepressed(x: number, y: number, button: number)
  if button ~= 1 then return end
  local column = math.floor((x - 32) / 148)
  local row = math.floor((y - 96) / 74)
  if column < 0 or column >= 4 or row < 0 then return end
  local index = row * 4 + column + 1
  local name = rawget(elements, index)
  if name ~= nil then choose(name) end
end

function love.keypressed(key: string)
  if key == "escape" then
    selected = nil
    message = "Selection cleared"
  end
end

function love.draw()
  love.graphics.clear(0.08, 0.09, 0.15)
  love.graphics.setColor(1, 1, 1)
  love.graphics.print("ALCHEMY LAB", 32, 24)
  love.graphics.print("Combine two elements. Escape clears selection.", 32, 52)
  for index, name in ipairs(elements) do
    local column = (index - 1) % 4
    local row = math.floor((index - 1) / 4)
    local x = 32 + column * 148
    local y = 96 + row * 74
    if selected ~= nil and selected:get() == name then
      love.graphics.setColor(0.35, 0.45, 0.8)
    else
      love.graphics.setColor(0.2, 0.25, 0.36)
    end
    love.graphics.rectangle("fill", x, y, 136, 58, 8, 8)
    love.graphics.setColor(1, 1, 1)
    love.graphics.print(name, x + 14, y + 20)
  end
  love.graphics.print(message, 32, 410)
  love.graphics.print("Discoveries: " .. #discoveries, 32, 440)
end

return { combine = combine, choose = choose, elements = elements, discoveries = discoveries }
