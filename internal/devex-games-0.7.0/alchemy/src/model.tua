final class Slot < T > {
  value: T

  init(value: T) {
    self.value = value
  }

  get(): T {
    return self.value
  }
}

export type SlotInstance < T > = Slot < T >

  local function remember<T>(value: T, history: T[]): T
  table.insert(history, value)
  return value
end

return { Slot = Slot, remember = remember }
