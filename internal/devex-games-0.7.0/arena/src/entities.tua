import type { Actor } from "./contracts"

final class Hero implements Actor {
  x: number
  y: number
  radius: number = 13

  init(x: number, y: number) {
    self.x = x
    self.y = y
  }

  update(dt: number): nil {
    local direction = 0
    if love.keyboard.isDown("left", "a") then direction -= 1 end
    if love.keyboard.isDown("right", "d") then direction += 1 end
    self.x += direction * 240 * dt
    self.x = math.max(self.radius, math.min(640 - self.radius, self.x))
  }

  draw(): nil {
    love.graphics.setColor(0.35, 0.9, 1)
    love.graphics.circle("fill", self.x, self.y, self.radius)
  }
}

final class Meteor implements Actor {
  x: number
  y: number
  speed: number
  radius: number

  init(x: number, y: number, speed: number, radius: number) {
    self.x = x
    self.y = y
    self.speed = speed
    self.radius = radius
  }

  update(dt: number): nil {
    self.y += self.speed * dt
    if self.y > 500 then
      self.y = -self.radius
      self.x = math.random(25, 615)
    end
  }

  draw(): nil {
    love.graphics.setColor(1, 0.45, 0.4)
    love.graphics.circle("fill", self.x, self.y, self.radius)
  }
}

-- Generic class state should retain its concrete type through a module export.
final class Box < T > {
  value: T

  init(value: T) {
    self.value = value
  }

  get(): T {
    return self.value
  }

  set(value: T): nil {
    self.value = value
  }
}

export type HeroInstance = Hero
export type MeteorInstance = Meteor
export type BoxInstance < T > = Box < T >
  return { Hero = Hero, Meteor = Meteor, Box = Box }
