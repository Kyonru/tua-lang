# Tua is not available in GitHub Linguist until it is accepted upstream.
# Keep the intended repository override here so it starts working once accepted.
*.tua linguist-language=Tua

# This template is embedded verbatim and must match the LF-only Rust constant
# on every checkout, including Windows runners with automatic CRLF conversion.
config/templates/*.toml text eol=lf

# These templates are embedded into web packages; keep their generated bytes
# identical on Windows and Unix checkouts.
crates/tua-cli/src/package/web_*.txt text eol=lf
crates/tua-cli/src/package/web_apache.htaccess text eol=lf
